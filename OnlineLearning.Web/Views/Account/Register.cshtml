@model OnlineLearning.Business.DTOs.RegisterDto

@{
    ViewData["Title"] = "Register";
}

<style>

    /* ================================
       REGISTER PAGE
    ================================= */

    .register-page {
        background-color: #FAF7F2;
        overflow: hidden;
    }


    /* ================================
       CARD ANIMATION
    ================================= */

    .register-card {
        opacity: 0;
        transform: translateY(35px) scale(0.98);

        animation:
            registerCardIn 0.8s ease forwards;

        transition:
            box-shadow 0.3s ease;
    }

    .register-card:hover {
        box-shadow:
            0 20px 50px rgba(24, 24, 27, 0.09) !important;
    }

    @@keyframes registerCardIn {

        0% {
            opacity: 0;
            transform: translateY(35px) scale(0.98);
        }

        100% {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

    }


    /* ================================
       LOGO ANIMATION
    ================================= */

    .brand-mark {
        display: flex;
        justify-content: center;
        align-items: center;

        opacity: 0;
        transform: translateY(-15px) scale(0.9);

        animation:
            logoIn 0.7s ease 0.25s forwards;
    }

    .brand-mark img {
        width: 100px;
        height: 100px;

        object-fit: contain;

        animation:
            logoFloat 4s ease-in-out 1s infinite;
    }

    .brand-mark-fallback {
        width: 90px;
        height: 90px;

        display: none;
        align-items: center;
        justify-content: center;

        border-radius: 24px;

        background-color: #EDE9FE;
        color: #7C3AED;

        font-size: 1.7rem;
        font-weight: 800;
    }

    @@keyframes logoIn {

        0% {
            opacity: 0;
            transform: translateY(-15px) scale(0.9);
        }

        100% {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

    }

    @@keyframes logoFloat {

        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-6px);
        }

    }


    /* ================================
       HEADER ANIMATION
    ================================= */

    .register-title {
        opacity: 0;
        transform: translateY(15px);

        animation:
            textIn 0.6s ease 0.4s forwards;
    }

    .register-subtitle {
        opacity: 0;
        transform: translateY(15px);

        animation:
            textIn 0.6s ease 0.5s forwards;
    }

    @@keyframes textIn {

        to {
            opacity: 1;
            transform: translateY(0);
        }

    }


    /* ================================
       FORM ANIMATION
    ================================= */

    .form-item {
        opacity: 0;
        transform: translateY(15px);

        animation:
            formItemIn 0.6s ease forwards;
    }

    .form-item-name {
        animation-delay: 0.6s;
    }

    .form-item-email {
        animation-delay: 0.7s;
    }

    .form-item-password {
        animation-delay: 0.8s;
    }

    .register-button-wrapper {
        opacity: 0;
        transform: translateY(15px);

        animation:
            formItemIn 0.6s ease 0.9s forwards;
    }

    .login-section {
        opacity: 0;
        transform: translateY(10px);

        animation:
            formItemIn 0.6s ease 1.05s forwards;
    }

    @@keyframes formItemIn {

        to {
            opacity: 1;
            transform: translateY(0);
        }

    }


    /* ================================
       INPUT EFFECT
    ================================= */

    .register-input {
        transition:
            border-color 0.25s ease,
            box-shadow 0.25s ease,
            transform 0.25s ease;
    }

    .register-input:focus {
        border-color: #A78BFA !important;

        box-shadow:
            0 0 0 4px rgba(124, 58, 237, 0.10) !important;

        transform: translateY(-1px);
    }


    /* ================================
       BUTTON EFFECT
    ================================= */

    .register-button {
        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease,
            background-color 0.25s ease;
    }

    .register-button:hover {
        background-color: #6D28D9 !important;

        transform: translateY(-2px);

        box-shadow:
            0 10px 25px rgba(124, 58, 237, 0.25);
    }

    .register-button:active {
        transform: translateY(0);
    }


    /* ================================
       LOGIN LINK
    ================================= */

    .login-link {
        transition:
            color 0.2s ease;
    }

    .login-link:hover {
        color: #6D28D9 !important;
    }


    /* ================================
       MOBILE
    ================================= */

    @@media (max-width: 575px) {

        .register-card {
            padding: 1.5rem !important;
        }

        .brand-mark img {
            width: 85px;
            height: 85px;
        }

    }

</style>


<div class="min-vh-100 d-flex align-items-center py-5 register-page">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">


                <!-- Register Card -->

                <div class="bg-white border rounded-4 p-4 p-md-5 shadow-sm register-card">


                    <!-- Header -->

                    <div class="text-center mb-4">


                        <div class="brand-mark mb-3">

                            <img src="~/images/Gemini_Generated_Image_snsprxsnsprxsnsp-removebg-preview.png"
                                 alt="Hub Sci logo"
                                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />

                            <span class="brand-mark-fallback">
                                HS
                            </span>

                        </div>


                        <h1 class="fw-bold mb-2 register-title"
                            style="color: #18181B;">

                            Create Your Account

                        </h1>


                        <p class="mb-0 register-subtitle"
                           style="color: #71717A;">

                            Start your learning journey today

                        </p>

                    </div>


                    <!-- Validation -->

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger small mb-3">

                    </div>


                    <!-- Register Form -->

                    <form asp-action="Register" method="post">


                        <!-- Name -->

                        <div class="mb-3 form-item form-item-name">

                            <label asp-for="Name"
                                   class="form-label fw-semibold"
                                   style="color: #18181B;">

                            </label>


                            <input asp-for="Name"
                                   class="form-control form-control-lg register-input"
                                   placeholder="Enter your full name"
                                   autocomplete="name"
                                   style="
                                       border-color: #E4E4E7;
                                       border-radius: 10px;
                                   " />


                            <span asp-validation-for="Name"
                                  class="text-danger small">

                            </span>

                        </div>


                        <!-- Email -->

                        <div class="mb-3 form-item form-item-email">

                            <label asp-for="Email"
                                   class="form-label fw-semibold"
                                   style="color: #18181B;">

                            </label>


                            <input asp-for="Email"
                                   type="email"
                                   class="form-control form-control-lg register-input"
                                   placeholder="Enter your email"
                                   autocomplete="email"
                                   style="
                                       border-color: #E4E4E7;
                                       border-radius: 10px;
                                   " />


                            <span asp-validation-for="Email"
                                  class="text-danger small">

                            </span>

                        </div>


                        <!-- Password -->

                        <div class="mb-4 form-item form-item-password">

                            <label asp-for="Password"
                                   class="form-label fw-semibold"
                                   style="color: #18181B;">

                            </label>


                            <input asp-for="Password"
                                   type="password"
                                   class="form-control form-control-lg register-input"
                                   placeholder="Create a password"
                                   autocomplete="new-password"
                                   style="
                                       border-color: #E4E4E7;
                                       border-radius: 10px;
                                   " />


                            <span asp-validation-for="Password"
                                  class="text-danger small">

                            </span>

                        </div>


                        <!-- Register Button -->

                        <div class="register-button-wrapper">

                            <button type="submit"
                                    class="btn w-100 py-2 fw-semibold text-white register-button"
                                    style="
                                        background-color: #7C3AED;
                                        border-radius: 10px;
                                        border: none;
                                    ">

                                Create Account

                            </button>

                        </div>

                    </form>


                    <!-- Login Link -->

                    <div class="text-center mt-4 login-section">

                        <span style="color: #71717A;">

                            Already have an account?

                        </span>


                        <a asp-action="Login"
                           class="text-decoration-none fw-semibold ms-1 login-link"
                           style="color: #7C3AED;">

                            Login

                        </a>

                    </div>

                </div>


                <!-- Footer -->

                <p class="text-center small mt-4 mb-0"
                   style="color: #71717A;">

                    Learn. Grow. Succeed.

                </p>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}