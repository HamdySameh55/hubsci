
@model OnlineLearning.Business.DTOs.CertificateDto

@{
    ViewData["Title"] = "Certificate";
}

<div class="certificate-page">

    <div class="container py-5">

        <!-- Back -->
        <div class="mb-4">
            <a asp-controller="Certificate"
               asp-action="Index"
               class="back-link">
                ← Back to My Certificates
            </a>
        </div>


        <!-- Certificate -->
        <div class="d-flex justify-content-center">

            <div class="certificate-wrapper">

                <div class="certificate-inner">

                    <!-- Decorative Corners -->
                    <div class="corner corner-top-left"></div>
                    <div class="corner corner-top-right"></div>
                    <div class="corner corner-bottom-left"></div>
                    <div class="corner corner-bottom-right"></div>


                    <!-- Logo / Mark -->
                    <div class="certificate-mark">
                        ✓
                    </div>


                    <!-- Brand -->
                    <div class="certificate-label">
                        hub sci
                    </div>


                    <!-- Title -->
                    <h1 class="certificate-title">
                        Certificate of Completion
                    </h1>


                    <p class="certificate-intro">
                        This certificate is proudly presented to
                    </p>


                    <!-- Student -->
                    <h2 class="student-name">
                        @Model.StudentName
                    </h2>


                    <div class="name-line"></div>


                    <p class="certificate-description">
                        for successfully completing the course
                    </p>


                    <!-- Course -->
                    <div class="course-name">
                        @Model.CourseTitle
                    </div>


                    <p class="completion-text">
                        and fulfilling all required course activities
                        and completion requirements.
                    </p>


                    <!-- Information -->
                    <div class="certificate-info">

                        <div class="info-box">

                            <div class="info-label">
                                CERTIFICATE ID
                            </div>

                            <div class="info-value">
                                #@Model.CertificateId
                            </div>

                        </div>


                        <div class="info-box">

                            <div class="info-label">
                                ISSUE DATE
                            </div>

                            <div class="info-value">
                                @Model.IssueDate.ToLocalTime().ToString("dd MMMM yyyy")
                            </div>

                        </div>


                        <div class="info-box">

                            <div class="info-label">
                                ENROLLMENT ID
                            </div>

                            <div class="info-value">
                                #@Model.EnrollmentId
                            </div>

                        </div>

                    </div>


                    <!-- Footer -->
                    <div class="certificate-footer">

                        <div class="signature">

                            <div class="signature-line"></div>

                            <span>
                                hub sci
                            </span>

                        </div>


                        <div class="footer-message">
                            Congratulations on completing your course.
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    body {
        background-color: #FAF7F2;
    }


    /* Page */

    .certificate-page {
        min-height: 100vh;
        background-color: #FAF7F2;
    }


    /* Back */

    .back-link {
        color: #7C3AED;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s ease;
    }

    .back-link:hover {
        color: #5B21B6;
    }


    /* Certificate Wrapper */

    .certificate-wrapper {
        width: 100%;
        max-width: 1050px;
        padding: 10px;
        background-color: #FFFFFF;
        border: 1px solid #DDD6FE;
        border-radius: 24px;
        box-shadow:
            0 20px 50px rgba(24, 24, 27, 0.08);
    }


    /* Certificate */

    .certificate-inner {
        position: relative;
        overflow: hidden;

        text-align: center;

        padding: 70px 70px 55px;

        background-color: #FFFFFF;

        border: 2px solid #7C3AED;

        border-radius: 18px;
    }


    /* Decorative Background */

    .certificate-inner::before {
        content: "";
        position: absolute;

        width: 260px;
        height: 260px;

        top: -130px;
        left: -130px;

        border-radius: 50%;

        background-color: #EDE9FE;

        opacity: 0.55;
    }


    .certificate-inner::after {
        content: "";
        position: absolute;

        width: 260px;
        height: 260px;

        bottom: -130px;
        right: -130px;

        border-radius: 50%;

        background-color: #EDE9FE;

        opacity: 0.55;
    }


    /* Decorative Corners */

    .corner {
        position: absolute;

        width: 55px;
        height: 55px;

        border-color: #7C3AED;
        border-style: solid;

        opacity: 0.65;

        z-index: 1;
    }


    .corner-top-left {
        top: 22px;
        left: 22px;

        border-width: 3px 0 0 3px;
    }


    .corner-top-right {
        top: 22px;
        right: 22px;

        border-width: 3px 3px 0 0;
    }


    .corner-bottom-left {
        bottom: 22px;
        left: 22px;

        border-width: 0 0 3px 3px;
    }


    .corner-bottom-right {
        bottom: 22px;
        right: 22px;

        border-width: 0 3px 3px 0;
    }


    /* Mark */

    .certificate-mark {
        position: relative;
        z-index: 2;

        width: 68px;
        height: 68px;

        margin: 0 auto 20px;

        border-radius: 50%;

        background-color: #EDE9FE;

        color: #7C3AED;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 28px;
        font-weight: 800;

        border: 2px solid #DDD6FE;
    }


    /* Brand */

    .certificate-label {
        position: relative;
        z-index: 2;

        color: #7C3AED;

        font-size: 12px;
        font-weight: 800;

        letter-spacing: 4px;

        margin-bottom: 18px;
    }


    /* Title */

    .certificate-title {
        position: relative;
        z-index: 2;

        color: #18181B;

        font-size: 42px;
        font-weight: 800;

        margin-bottom: 18px;
    }


    /* Intro */

    .certificate-intro {
        position: relative;
        z-index: 2;

        color: #71717A;

        font-size: 16px;

        margin-bottom: 15px;
    }


    /* Student */

    .student-name {
        position: relative;
        z-index: 2;

        color: #5B21B6;

        font-size: 34px;
        font-weight: 800;

        margin-bottom: 10px;
    }


    .name-line {
        position: relative;
        z-index: 2;

        width: 280px;
        height: 2px;

        margin: 0 auto 22px;

        background-color: #DDD6FE;
    }


    /* Description */

    .certificate-description {
        position: relative;
        z-index: 2;

        color: #71717A;

        font-size: 15px;

        margin-bottom: 12px;
    }


    /* Course */

    .course-name {
        position: relative;
        z-index: 2;

        color: #18181B;

        font-size: 26px;
        font-weight: 800;

        margin: 10px auto 14px;

        max-width: 700px;
    }


    .completion-text {
        position: relative;
        z-index: 2;

        max-width: 650px;

        margin: 0 auto 45px;

        color: #71717A;

        font-size: 14px;

        line-height: 1.7;
    }


    /* Information */

    .certificate-info {
        position: relative;
        z-index: 2;

        display: flex;

        justify-content: center;

        gap: 20px;

        margin-bottom: 45px;
    }


    .info-box {
        flex: 1;

        max-width: 250px;

        padding: 18px 15px;

        background-color: #FAF7F2;

        border: 1px solid #E4E4E7;

        border-radius: 12px;
    }


    .info-label {
        color: #71717A;

        font-size: 10px;
        font-weight: 800;

        letter-spacing: 1.5px;

        margin-bottom: 7px;
    }


    .info-value {
        color: #18181B;

        font-size: 14px;

        font-weight: 700;
    }


    /* Footer */

    .certificate-footer {
        position: relative;
        z-index: 2;

        display: flex;

        align-items: end;

        justify-content: space-between;

        gap: 30px;

        padding-top: 28px;

        border-top: 1px solid #E4E4E7;
    }


    .signature {
        text-align: center;

        min-width: 180px;
    }


    .signature-line {
        width: 170px;

        height: 1px;

        background-color: #18181B;

        margin-bottom: 8px;
    }


    .signature span {
        color: #52525B;

        font-size: 12px;

        font-weight: 600;
    }


    .footer-message {
        color: #71717A;

        font-size: 13px;

        text-align: right;
    }


    /* Responsive */

    @@media (max-width: 768px) {

        .certificate-inner {
            padding: 55px 25px 40px;
        }

        .certificate-title {
            font-size: 30px;
        }

        .student-name {
            font-size: 26px;
        }

        .course-name {
            font-size: 21px;
        }

        .certificate-info {
            flex-direction: column;
            align-items: center;
        }

        .info-box {
            width: 100%;
            max-width: 320px;
        }

        .certificate-footer {
            flex-direction: column;
            align-items: center;
        }

        .footer-message {
            text-align: center;
        }

    }

</style>
