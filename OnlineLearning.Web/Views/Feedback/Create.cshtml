@model OnlineLearning.Business.DTOs.CreateFeedbackDto

@{
ViewData["Title"] = "Give Feedback";
}

<div class="container py-5">

<!-- Back -->
<div class="mb-4">
    <a asp-controller="Feedback"
       asp-action="Index"
       class="back-link">
        ← Back to My Feedback
    </a>
</div>


<div class="row justify-content-center">

    <div class="col-md-8 col-lg-6">

        <!-- Header -->
        <div class="mb-4">

            <div class="small fw-semibold mb-2"
                 style="color: #7C3AED;">
                COURSE FEEDBACK
            </div>

            <h1 class="fw-bold mb-2"
                style="color: #18181B;">
                Give Feedback
            </h1>

            <p class="mb-0"
               style="color: #71717A;">
                Share your experience with this course.
            </p>

        </div>


        <!-- Error -->
        @if (TempData["Error"] != null)
        {
            <div class="custom-alert error-alert mb-4">

                <div class="alert-icon">
                    !
                </div>

                <div>
                    <div class="fw-semibold"
                         style="color: #991B1B;">
                        Something went wrong
                    </div>

                    <div class="small"
                         style="color: #991B1B;">
                        @TempData["Error"]
                    </div>
                </div>

            </div>
        }


        <!-- Feedback Card -->
        <div class="feedback-form-card">

            <div class="feedback-card-header">

                <div class="feedback-icon">
                    ★
                </div>

                <div>
                    <h4 class="fw-bold mb-1"
                        style="color: #18181B;">
                        Course Feedback
                    </h4>

                    <p class="small mb-0"
                       style="color: #71717A;">
                        Tell us what you think about this course.
                    </p>
                </div>

            </div>


            <div class="feedback-card-body">

                <form asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           asp-for="CourseId" />


                    <!-- Rating -->
                    <div class="mb-4">

                        <label asp-for="Rating"
                               class="form-label fw-semibold"
                               style="color: #27272A;">
                            Rating
                        </label>

                        <select asp-for="Rating"
                                class="form-select custom-input">

                            <option value="0">
                                No rating
                            </option>

                            <option value="1">
                                1 / 5
                            </option>

                            <option value="2">
                                2 / 5
                            </option>

                            <option value="3">
                                3 / 5
                            </option>

                            <option value="4">
                                4 / 5
                            </option>

                            <option value="5">
                                5 / 5
                            </option>

                        </select>

                        <div class="form-text custom-help">
                            Rating is optional.
                        </div>

                        <span asp-validation-for="Rating"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- Comment -->
                    <div class="mb-4">

                        <label asp-for="Comment"
                               class="form-label fw-semibold"
                               style="color: #27272A;">
                            Comment
                        </label>

                        <textarea asp-for="Comment"
                                  class="form-control custom-input"
                                  rows="6"
                                  maxlength="1000"
                                  placeholder="Tell us about your experience with this course..."></textarea>

                        <div class="form-text custom-help">
                            You can leave a comment without a rating,
                            but at least a rating or a comment is required.
                        </div>

                        <span asp-validation-for="Comment"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- Actions -->
                    <div class="d-flex flex-column flex-sm-row
                                justify-content-end
                                gap-3">

                        <a asp-controller="Feedback"
                           asp-action="Index"
                           class="btn btn-light-custom">
                            Cancel
                        </a>

                        <button type="submit"
                                class="btn btn-purple">
                            Submit Feedback
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

</div>

<style>

    body {
        background-color: #FAF7F2;
    }


    /* Back */

    .back-link {
        color: #7C3AED;
        text-decoration: none;
        font-weight: 600;
    }

    .back-link:hover {
        color: #5B21B6;
    }


    /* Card */

    .feedback-form-card {
        background-color: #FFFFFF;
        border: 1px solid #E4E4E7;
        border-radius: 20px;
        overflow: hidden;
    }

    .feedback-card-header {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 24px 28px;
        background-color: #EDE9FE;
        border-bottom: 1px solid #DDD6FE;
    }

    .feedback-card-body {
        padding: 28px;
    }


    /* Icon */

    .feedback-icon {
        width: 48px;
        height: 48px;
        min-width: 48px;
        border-radius: 14px;
        background-color: #7C3AED;
        color: #FFFFFF;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        font-weight: 800;
    }


    /* Inputs */

    .custom-input {
        border: 1px solid #E4E4E7;
        border-radius: 10px;
        padding: 11px 13px;
        background-color: #FFFFFF;
        color: #18181B;
    }

    textarea.custom-input {
        resize: vertical;
    }

    .custom-input:focus {
        border-color: #7C3AED;
        box-shadow: 0 0 0 0.2rem rgba(124, 58, 237, 0.12);
        outline: none;
    }

    .custom-help {
        color: #71717A;
        font-size: 12px;
        margin-top: 7px;
    }


    /* Buttons */

    .btn-purple {
        background-color: #7C3AED;
        border: 1px solid #7C3AED;
        color: #FFFFFF;
        border-radius: 10px;
        padding: 10px 20px;
        font-weight: 600;
    }

    .btn-purple:hover {
        background-color: #5B21B6;
        border-color: #5B21B6;
        color: #FFFFFF;
    }

    .btn-light-custom {
        background-color: #FFFFFF;
        border: 1px solid #E4E4E7;
        color: #27272A;
        border-radius: 10px;
        padding: 10px 20px;
        font-weight: 600;
    }

    .btn-light-custom:hover {
        background-color: #F4F4F5;
        border-color: #D4D4D8;
        color: #18181B;
    }


    /* Alert */

    .custom-alert {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 16px 18px;
        border-radius: 12px;
    }

    .error-alert {
        background-color: #FEF2F2;
        border: 1px solid #FECACA;
    }

    .alert-icon {
        width: 30px;
        height: 30px;
        min-width: 30px;
        border-radius: 8px;
        background-color: #FEE2E2;
        color: #DC2626;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
    }

</style>

@section Scripts {
@{
await Html.RenderPartialAsync(
"_ValidationScriptsPartial");
}
}
