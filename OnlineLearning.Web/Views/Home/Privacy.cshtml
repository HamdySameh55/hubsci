@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="py-5"
     style="background-color: #FAF7F2; min-height: 100vh;">

    <div class="container py-4">

        <div class="mx-auto"
             style="max-width: 760px;">

            <div class="bg-white border rounded-4 p-4 p-md-5 shadow-sm">

                <h1 class="fw-bold mb-3"
                    style="
                        color: #18181B;
                        letter-spacing: -0.5px;">
                    @ViewData["Title"]
                </h1>

                <p class="fs-5 mb-4"
                   style="color: #71717A;">
                    Your privacy matters at Hub Sci. This page outlines
                    how we collect, use, and protect your information.
                </p>

                <h5 class="fw-bold mb-2"
                    style="color: #18181B;">
                    Information We Collect
                </h5>

                <p style="color: #71717A; line-height: 1.7;">
                    We collect the information you provide when you
                    create an account, such as your name and email
                    address, along with data related to your enrollments
                    and learning progress.
                </p>

                <h5 class="fw-bold mb-2 mt-4"
                    style="color: #18181B;">
                    How We Use Your Information
                </h5>

                <p style="color: #71717A; line-height: 1.7;">
                    Your information is used to personalize your
                    experience, deliver course content, process
                    enrollments, and improve our platform. We do not
                    sell your personal data.
                </p>

                <h5 class="fw-bold mb-2 mt-4"
                    style="color: #18181B;">
                    Contact Us
                </h5>

                <p class="mb-0"
                   style="color: #71717A; line-height: 1.7;">
                    If you have any questions about this policy, reach
                    out to our support team and we will be happy to help.
                </p>

            </div>

        </div>

    </div>

</div>