@model OnlineLearning.Web.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home";
}

<style>

    /* =========================
       GLOBAL ANIMATIONS
       ========================= */

    .home-animate {
        opacity: 0;
        transform: translateY(30px);
        animation: homeFadeUp 0.8s ease forwards;
    }

    .home-delay-1 {
        animation-delay: 0.1s;
    }

    .home-delay-2 {
        animation-delay: 0.2s;
    }

    .home-delay-3 {
        animation-delay: 0.3s;
    }

    .home-delay-4 {
        animation-delay: 0.4s;
    }

    .home-delay-5 {
        animation-delay: 0.5s;
    }

    .home-delay-6 {
        animation-delay: 0.6s;
    }


    @@keyframes homeFadeUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* =========================
       HERO VISUAL
       ========================= */

    .hero-visual-animated {
        opacity: 0;
        transform: translateX(50px) scale(.96);
        animation: heroVisualIn 1s ease forwards;
        animation-delay: .25s;
    }

    @@keyframes heroVisualIn {
        from {
            opacity: 0;
            transform: translateX(50px) scale(.96);
        }

        to {
            opacity: 1;
            transform: translateX(0) scale(1);
        }
    }


    /* =========================
       HERO IMAGE
       ========================= */

    .hub-sci-hero-img {
        width: 100%;
        height: 390px;
        object-fit: contain;
        display: block;
        transition: transform .5s ease;
    }

    .hero-image-container {
        transition: transform .4s ease, box-shadow .4s ease;
    }

    .hero-image-container:hover {
        transform: translateY(-6px);
        box-shadow: 0 20px 45px rgba(124, 58, 237, .12) !important;
    }

    .hero-image-container:hover .hub-sci-hero-img {
        transform: scale(1.04);
    }


    /* =========================
       BUTTON ANIMATION
       ========================= */

    .animated-btn {
        transition:
            transform .25s ease,
            box-shadow .25s ease,
            background-color .25s ease;
    }

    .animated-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(124, 58, 237, .18);
    }

    .animated-btn:active {
        transform: translateY(0);
    }


    /* =========================
       CARD ANIMATION
       ========================= */

    .animated-card {
        opacity: 0;
        transform: translateY(35px);
        animation: cardFadeUp .7s ease forwards;
        transition:
            transform .3s ease,
            box-shadow .3s ease;
    }

    .animated-card:hover {
        transform: translateY(-7px);
        box-shadow: 0 18px 35px rgba(24, 24, 27, .08) !important;
    }

    @@keyframes cardFadeUp {
        from {
            opacity: 0;
            transform: translateY(35px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    .course-card-1 {
        animation-delay: .1s;
    }

    .course-card-2 {
        animation-delay: .2s;
    }

    .course-card-3 {
        animation-delay: .3s;
    }

    .course-card-4 {
        animation-delay: .4s;
    }

    .course-card-5 {
        animation-delay: .5s;
    }

    .course-card-6 {
        animation-delay: .6s;
    }


    /* =========================
       BADGE ANIMATION
       ========================= */

    .animated-badge {
        animation: badgePulse 2.5s ease-in-out infinite;
    }

    @@keyframes badgePulse {

        0%,
        100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.04);
        }
    }


    /* =========================
       STUDENT PROGRESS CIRCLE
       ========================= */

    .progress-circle-animated {
        animation: progressCircle 1s ease forwards;
    }

    @@keyframes progressCircle {

        from {
            transform: scale(.7);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }


    /* =========================
       PROGRESS BAR
       ========================= */

    .animated-progress-bar {
        animation: progressBarGrow 1.4s ease forwards;
        transform-origin: left;
    }

    @@keyframes progressBarGrow {
        from {
            width: 0 !important;
        }
    }


    /* =========================
       FLOATING VISUAL
       ========================= */

    .floating-card {
        animation: floatingCard 4s ease-in-out infinite;
    }

    @@keyframes floatingCard {

        0%,
        100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-7px);
        }
    }


    /* =========================
       CTA
       ========================= */

    .animated-cta {
        opacity: 0;
        transform: translateY(30px);
        animation: ctaIn .8s ease forwards;
    }

    @@keyframes ctaIn {

        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* =========================
       TEXT SHINE
       ========================= */

    .animated-title {
        animation: titleIn .9s ease forwards;
    }

    @@keyframes titleIn {

        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* =========================
       REDUCED MOTION
       ========================= */

    @@media (prefers-reduced-motion: reduce) {

        *,
        *::before,
        *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
        }

    }

</style>


<div style="background-color: #FAF7F2; min-height: 100vh;">

    <!-- =========================
         ROLE-BASED HERO SECTION
         ========================= -->

    <section class="py-5">

        <div class="container py-4 py-lg-5">

            @* =========================================================
               GUEST HERO
               ========================================================= *@

            @if (!User.Identity?.IsAuthenticated ?? true)
            {
                <div class="row align-items-center g-5">

                    <div class="col-12 col-lg-6 home-animate">

                        <span class="badge rounded-pill px-3 py-2 mb-4 animated-badge"
                              style="
                                  background-color: #EDE9FE;
                                  color: #7C3AED;
                                  font-weight: 600;">

                            Learn. Explore. Discover.

                        </span>


                        <h1 class="display-4 fw-bold mb-4 animated-title"
                            style="
                                color: #18181B;
                                letter-spacing: -1.5px;">

                            Explore knowledge.

                            <span style="color: #7C3AED;">

                                Build your future.

                            </span>

                        </h1>


                        <p class="fs-5 mb-4 home-delay-1 home-animate"
                           style="
                               color: #71717A;
                               line-height: 1.8;
                               max-width: 560px;">

                            Discover practical courses, develop real skills,
                            and turn what you learn into something meaningful.

                        </p>


                        <div class="d-flex flex-column flex-sm-row gap-3 home-delay-2 home-animate">

                            <a asp-controller="Course"
                               asp-action="Index"
                               class="btn px-4 py-3 fw-semibold animated-btn"
                               style="
                                   background-color: #7C3AED;
                                   color: white;
                                   border: none;
                                   border-radius: 10px;">

                                Explore Courses

                            </a>


                            <a asp-controller="Account"
                               asp-action="Register"
                               class="btn px-4 py-3 fw-semibold animated-btn"
                               style="
                                   background-color: white;
                                   color: #7C3AED;
                                   border: 1px solid #DDD6FE;
                                   border-radius: 10px;">

                                Get Started

                            </a>

                        </div>

                    </div>


                    <!-- Science Visual -->

                    <div class="col-12 col-lg-6 hero-visual-animated">

                        <div class="rounded-4 overflow-hidden shadow-sm hero-image-container"
                             style="
                                 min-height: 390px;
                                 background:
                                    linear-gradient(
                                        135deg,
                                        rgba(124,58,237,.10),
                                        rgba(250,247,242,.35)
                                    );
                                 border: 1px solid #E4E4E7;">

                            <img src="~/images/Gemini_Generated_Image_snsprxsnsprxsnsp-removebg-preview.png"
                                 alt="Science and learning"
                                 class="hub-sci-hero-img">

                        </div>

                    </div>

                </div>
            }


            @* =========================================================
               STUDENT HERO
               ========================================================= *@

            else if (User.IsInRole("Student"))
            {

                @if (Model.Student?.Course != null &&
                     Model.Student.Progress != null)
                {

                    var course = Model.Student.Course;

                    var progress = Model.Student.Progress;

                    var totalActivities =
                        progress.TotalLessons +
                        progress.TotalQuizzes;

                    var completedActivities =
                        progress.CompletedLessons +
                        progress.PassedQuizzes;

                    var remainingActivities =
                        Math.Max(
                            0,
                            totalActivities - completedActivities);


                    <div class="row align-items-center g-5">

                        <!-- Student Hero Text -->

                        <div class="col-12 col-lg-7 home-animate">

                            <span class="badge rounded-pill px-3 py-2 mb-4 animated-badge"
                                  style="
                                      background-color: #EDE9FE;
                                      color: #7C3AED;
                                      font-weight: 600;">

                                Welcome back 👋

                            </span>


                            @if (progress.IsCompleted)
                            {

                                <h1 class="display-5 fw-bold mb-4 animated-title"
                                    style="
                                        color: #18181B;
                                        letter-spacing: -1.5px;">

                                    You did it!

                                    <span style="color: #16A34A;">

                                        🎉

                                    </span>

                                </h1>


                                <p class="fs-5 mb-4 home-delay-1 home-animate"
                                   style="
                                       color: #71717A;
                                       line-height: 1.8;
                                       max-width: 600px;">

                                    You've successfully completed

                                    <strong style="color: #18181B;">

                                        @course.Title

                                    </strong>.

                                    Keep learning and take the next step
                                    in your journey.

                                </p>

                            }

                            else
                            {

                                <h1 class="display-5 fw-bold mb-4 animated-title"
                                    style="
                                        color: #18181B;
                                        letter-spacing: -1.5px;">

                                    Keep going.

                                    <span style="color: #7C3AED;">

                                        You're doing great! 🔥

                                    </span>

                                </h1>


                                <p class="fs-5 mb-4 home-delay-1 home-animate"
                                   style="
                                       color: #71717A;
                                       line-height: 1.8;
                                       max-width: 600px;">

                                    Continue your journey in

                                    <strong style="color: #18181B;">

                                        @course.Title

                                    </strong>

                                    and keep building your skills.

                                </p>

                            }


                            <!-- Course Card -->

                            <div class="bg-white rounded-4 shadow-sm p-4 mb-4 animated-card course-card-1"
                                 style="
                                     border: 1px solid #E4E4E7;
                                     max-width: 620px;">

                                <div class="d-flex justify-content-between
                                            align-items-start gap-3 mb-3">

                                    <div>

                                        <div class="small fw-semibold mb-1"
                                             style="color: #7C3AED;">

                                            CONTINUE LEARNING

                                        </div>

                                        <h3 class="fw-bold mb-0"
                                            style="color: #18181B;">

                                            @course.Title

                                        </h3>

                                    </div>


                                    <span class="fw-bold"
                                          style="color: #7C3AED;">

                                        @progress.ProgressPercentage.ToString("0")%

                                    </span>

                                </div>


                                <!-- Progress -->

                                <div class="progress mb-3"
                                     style="
                                         height: 9px;
                                         background-color: #E4E4E7;">

                                    <div class="progress-bar animated-progress-bar"
                                         role="progressbar"
                                         style="
                                             width: @progress.ProgressPercentage%;
                                             background-color: #7C3AED;">

                                    </div>

                                </div>


                                <div class="d-flex flex-wrap gap-3 small"
                                     style="color: #71717A;">

                                    <span>

                                        ✓ @progress.CompletedLessons /
                                        @progress.TotalLessons Lessons

                                    </span>

                                    <span>

                                        ✓ @progress.PassedQuizzes /
                                        @progress.TotalQuizzes Quizzes

                                    </span>

                                </div>

                            </div>


                            <!-- Button -->

                            @if (progress.IsCompleted)
                            {

                                <a asp-controller="Course"
                                   asp-action="Details"
                                   asp-route-id="@course.CourseId"
                                   class="btn px-4 py-3 fw-semibold animated-btn"
                                   style="
                                       background-color: #16A34A;
                                       color: white;
                                       border: none;
                                       border-radius: 10px;">

                                    View Completed Course

                                </a>

                            }

                            else
                            {

                                <a asp-controller="Course"
                                   asp-action="Details"
                                   asp-route-id="@course.CourseId"
                                   class="btn px-4 py-3 fw-semibold animated-btn"
                                   style="
                                       background-color: #7C3AED;
                                       color: white;
                                       border: none;
                                       border-radius: 10px;">

                                    Continue Learning →

                                </a>

                            }

                        </div>


                        <!-- Student Progress Visual -->

                        <div class="col-12 col-lg-5 hero-visual-animated">

                            <div class="rounded-4 p-4 p-md-5 floating-card"
                                 style="
                                     background: linear-gradient(
                                         135deg,
                                         #EDE9FE,
                                         #F5F3FF
                                     );
                                     border: 1px solid #DDD6FE;">

                                <div class="bg-white rounded-4 shadow-sm p-4">

                                    <div class="text-center mb-4">

                                        <div class="d-flex
                                                    align-items-center
                                                    justify-content-center
                                                    mx-auto
                                                    rounded-circle
                                                    mb-3
                                                    progress-circle-animated"
                                             style="
                                                 width: 110px;
                                                 height: 110px;
                                                 background-color: #EDE9FE;
                                                 color: #7C3AED;">

                                            <span class="fw-bold fs-2">

                                                @progress.ProgressPercentage.ToString("0")%

                                            </span>

                                        </div>


                                        <h4 class="fw-bold mb-1"
                                            style="color: #18181B;">

                                            Your Progress

                                        </h4>


                                        <p class="small mb-0"
                                           style="color: #71717A;">

                                            @course.Title

                                        </p>

                                    </div>


                                    <div class="row g-3">

                                        <div class="col-6">

                                            <div class="p-3 rounded-3 animated-card"
                                                 style="
                                                     background-color: #FAF7F2;">

                                                <div class="small mb-1"
                                                     style="color: #71717A;">

                                                    Lessons

                                                </div>

                                                <div class="fs-4 fw-bold"
                                                     style="color: #18181B;">

                                                    @progress.CompletedLessons

                                                </div>

                                                <div class="small"
                                                     style="color: #A1A1AA;">

                                                    of @progress.TotalLessons

                                                </div>

                                            </div>

                                        </div>


                                        <div class="col-6">

                                            <div class="p-3 rounded-3 animated-card"
                                                 style="
                                                     background-color: #F0FDF4;">

                                                <div class="small mb-1"
                                                     style="color: #71717A;">

                                                    Quizzes

                                                </div>

                                                <div class="fs-4 fw-bold"
                                                     style="color: #16A34A;">

                                                    @progress.PassedQuizzes

                                                </div>

                                                <div class="small"
                                                     style="color: #A1A1AA;">

                                                    of @progress.TotalQuizzes

                                                </div>

                                            </div>

                                        </div>

                                    </div>


                                    <div class="mt-3 p-3 rounded-3"
                                         style="
                                             background-color: #FAF7F2;">

                                        @if (progress.IsCompleted)
                                        {

                                            <div class="fw-semibold"
                                                 style="color: #16A34A;">

                                                🎉 Course completed!

                                            </div>

                                        }

                                        else
                                        {

                                            <div class="fw-semibold"
                                                 style="color: #18181B;">

                                                🔥 @remainingActivities
                                                activities remaining

                                            </div>

                                        }

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                }

                else
                {

                    <!-- Student Without Active Course -->

                    <div class="row align-items-center g-5">

                        <div class="col-12 col-lg-7 home-animate">

                            <span class="badge rounded-pill px-3 py-2 mb-4 animated-badge"
                                  style="
                                      background-color: #EDE9FE;
                                      color: #7C3AED;
                                      font-weight: 600;">

                                Welcome back 👋

                            </span>


                            <h1 class="display-4 fw-bold mb-4 animated-title"
                                style="
                                    color: #18181B;
                                    letter-spacing: -1.5px;">

                                Ready to start your

                                <span style="color: #7C3AED;">

                                    learning journey?

                                </span>

                            </h1>


                            <p class="fs-5 mb-4 home-delay-1 home-animate"
                               style="
                                   color: #71717A;
                                   line-height: 1.8;
                                   max-width: 560px;">

                                Explore our courses, find something you love,
                                and start building skills that move you forward.

                            </p>


                            <a asp-controller="Course"
                               asp-action="Index"
                               class="btn px-4 py-3 fw-semibold animated-btn home-delay-2 home-animate"
                               style="
                                   background-color: #7C3AED;
                                   color: white;
                                   border: none;
                                   border-radius: 10px;">

                                Explore Courses →

                            </a>

                        </div>


                        <div class="col-12 col-lg-5 hero-visual-animated">

                            <div class="bg-white rounded-4 shadow-sm p-5 text-center floating-card"
                                 style="border: 1px solid #E4E4E7;">

                                <div class="fs-1 mb-3">

                                    🚀

                                </div>


                                <h4 class="fw-bold mb-2"
                                    style="color: #18181B;">

                                    Your next chapter starts here.

                                </h4>


                                <p class="mb-0"
                                   style="color: #71717A;">

                                    Choose a course and start learning today.

                                </p>

                            </div>

                        </div>

                    </div>

                }

            }


            @* =========================================================
               INSTRUCTOR HERO
               ========================================================= *@

            else if (User.IsInRole("Instructor"))
            {

                <div class="row align-items-center g-5">

                    <div class="col-12 col-lg-7 home-animate">

                        <span class="badge rounded-pill px-3 py-2 mb-4 animated-badge"
                              style="
                                  background-color: #EDE9FE;
                                  color: #7C3AED;
                                  font-weight: 600;">

                            INSTRUCTOR

                        </span>


                        <h1 class="display-4 fw-bold mb-4 animated-title"
                            style="
                                color: #18181B;
                                letter-spacing: -1.5px;">

                            Share your knowledge.

                            <span style="color: #7C3AED;">

                                Inspire learners.

                            </span>

                        </h1>


                        <p class="fs-5 mb-4 home-delay-1 home-animate"
                           style="
                               color: #71717A;
                               line-height: 1.8;
                               max-width: 580px;">

                            Create valuable courses, organize your content,
                            and help students build real-world skills.

                        </p>


                        <div class="d-flex flex-column flex-sm-row gap-3 home-delay-2 home-animate">

                            <a asp-controller="Course"
                               asp-action="Create"
                               class="btn px-4 py-3 fw-semibold animated-btn"
                               style="
                                   background-color: #7C3AED;
                                   color: white;
                                   border: none;
                                   border-radius: 10px;">

                                Create Course

                            </a>


                            <a asp-controller="Course"
                               asp-action="Index"
                               class="btn px-4 py-3 fw-semibold animated-btn"
                               style="
                                   background-color: white;
                                   color: #7C3AED;
                                   border: 1px solid #DDD6FE;
                                   border-radius: 10px;">

                                My Courses

                            </a>

                        </div>

                    </div>


                    <div class="col-12 col-lg-5 hero-visual-animated">

                        <div class="rounded-4 p-4 p-md-5 floating-card"
                             style="
                                 background: linear-gradient(
                                     135deg,
                                     #EDE9FE,
                                     #F5F3FF
                                 );
                                 border: 1px solid #DDD6FE;">

                            <div class="bg-white rounded-4 shadow-sm p-4">

                                <div class="d-flex align-items-center gap-3 mb-4">

                                    <div class="d-flex align-items-center
                                                justify-content-center
                                                rounded-3"
                                         style="
                                             width: 54px;
                                             height: 54px;
                                             background-color: #EDE9FE;
                                             color: #7C3AED;">

                                        <span class="fs-4">

                                            ✦

                                        </span>

                                    </div>


                                    <div>

                                        <div class="fw-bold"
                                             style="color: #18181B;">

                                            Your Teaching Space

                                        </div>

                                        <div class="small"
                                             style="color: #71717A;">

                                            Build. Teach. Inspire.

                                        </div>

                                    </div>

                                </div>


                                <div class="p-3 rounded-3 mb-3 animated-card"
                                     style="background-color: #FAF7F2;">

                                    <div class="small mb-1"
                                         style="color: #71717A;">

                                        What you can do

                                    </div>

                                    <div class="fw-semibold"
                                         style="color: #18181B;">

                                        Create and manage your courses

                                    </div>

                                </div>


                                <div class="p-3 rounded-3 animated-card"
                                     style="background-color: #F0FDF4;">

                                    <div class="small mb-1"
                                         style="color: #71717A;">

                                        Your goal

                                    </div>

                                    <div class="fw-semibold"
                                         style="color: #16A34A;">

                                        Help students succeed

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            }


            @* =========================================================
               ADMIN HERO
               ========================================================= *@

            else if (User.IsInRole("Admin"))
            {

                <div class="row align-items-center g-5">

                    <div class="col-12 col-lg-7 home-animate">

                        <span class="badge rounded-pill px-3 py-2 mb-4 animated-badge"
                              style="
                                  background-color: #EDE9FE;
                                  color: #7C3AED;
                                  font-weight: 600;">

                            ADMIN PANEL

                        </span>


                        <h1 class="display-4 fw-bold mb-4 animated-title"
                            style="
                                color: #18181B;
                                letter-spacing: -1.5px;">

                            Manage the platform.

                            <span style="color: #7C3AED;">

                                Keep it growing.

                            </span>

                        </h1>


                        <p class="fs-5 mb-4 home-delay-1 home-animate"
                           style="
                               color: #71717A;
                               line-height: 1.8;
                               max-width: 580px;">

                            Monitor users, courses, enrollments, and platform
                            activity from one central place.

                        </p>


                        <a asp-controller="Admin"
                           asp-action="Dashboard"
                           class="btn px-4 py-3 fw-semibold animated-btn home-delay-2 home-animate"
                           style="
                               background-color: #7C3AED;
                               color: white;
                               border: none;
                               border-radius: 10px;">

                            Open Dashboard →

                        </a>

                    </div>


                    <div class="col-12 col-lg-5 hero-visual-animated">

                        <div class="rounded-4 p-4 p-md-5 floating-card"
                             style="
                                 background: linear-gradient(
                                     135deg,
                                     #EDE9FE,
                                     #F5F3FF
                                 );
                                 border: 1px solid #DDD6FE;">

                            <div class="bg-white rounded-4 shadow-sm p-4">

                                <div class="fw-bold mb-4"
                                     style="color: #18181B;">

                                    Platform Overview

                                </div>


                                <div class="p-3 rounded-3 mb-3 animated-card"
                                     style="background-color: #FAF7F2;">

                                    <div class="small"
                                         style="color: #71717A;">

                                        Platform

                                    </div>

                                    <div class="fw-semibold"
                                         style="color: #18181B;">

                                        Online Learning

                                    </div>

                                </div>


                                <div class="p-3 rounded-3 animated-card"
                                     style="background-color: #F0FDF4;">

                                    <div class="small"
                                         style="color: #71717A;">

                                        Status

                                    </div>

                                    <div class="fw-semibold"
                                         style="color: #16A34A;">

                                        Running smoothly ✓

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            }

        </div>

    </section>


    <!-- =========================
         COURSES SECTION
         ========================= -->

    <section class="pb-5">

        <div class="container py-4">

            <div class="d-flex flex-column flex-md-row
                        justify-content-between
                        align-items-md-end
                        gap-3
                        mb-4 home-animate">

                <div>

                    <div class="small fw-semibold mb-2"
                         style="color: #7C3AED;">

                        EXPLORE

                    </div>


                    <h2 class="fw-bold mb-2"
                        style="
                            color: #18181B;
                            letter-spacing: -0.5px;">

                        Featured Courses

                    </h2>


                    <p class="mb-0"
                       style="color: #71717A;">

                        Explore our published courses and start learning.

                    </p>

                </div>


                <a asp-controller="Course"
                   asp-action="Index"
                   class="text-decoration-none fw-semibold animated-btn"
                   style="color: #7C3AED;">

                    View all courses →

                </a>

            </div>


            @if (Model.Courses != null && Model.Courses.Any())
            {

                <div class="row g-4">

                    @{
                        var courseIndex = 0;
                    }

                    @foreach (var course in Model.Courses)
                    {

                        courseIndex++;

                        <div class="col-12 col-md-6 col-lg-4">

                            <div class="bg-white rounded-4 h-100 shadow-sm animated-card course-card-@courseIndex"
                                 style="
                                     border: 1px solid #E4E4E7;
                                     overflow: hidden;">

                                <div class="p-4"
                                     style="
                                         background-color: #F5F3FF;
                                         min-height: 130px;">

                                    <div class="d-flex justify-content-between
                                                align-items-start gap-3">

                                        <span class="badge rounded-pill px-3 py-2"
                                              style="
                                                  background-color: #EDE9FE;
                                                  color: #7C3AED;
                                                  font-weight: 600;">

                                            Course

                                        </span>


                                        <span class="fw-bold"
                                              style="color: #18181B;">

                                            @course.Price.ToString("0.00") EGP

                                        </span>

                                    </div>

                                </div>


                                <div class="p-4 d-flex flex-column"
                                     style="min-height: 250px;">

                                    <h4 class="fw-bold mb-3"
                                        style="color: #18181B;">

                                        @course.Title

                                    </h4>


                                    <p class="mb-4"
                                       style="
                                           color: #71717A;
                                           line-height: 1.7;">

                                        @(string.IsNullOrWhiteSpace(course.Description)
                                            ? "Start learning with this course and build your skills."
                                            : course.Description)

                                    </p>


                                    <div class="mt-auto">

                                        <a asp-controller="Course"
                                           asp-action="Details"
                                           asp-route-id="@course.CourseId"
                                           class="btn w-100 py-2 fw-semibold animated-btn"
                                           style="
                                               background-color: #7C3AED;
                                               color: white;
                                               border: none;
                                               border-radius: 10px;">

                                            View Course

                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>

                    }

                </div>

            }

            else
            {

                <div class="bg-white rounded-4 p-5 text-center animated-card"
                     style="border: 1px solid #E4E4E7;">

                    <div class="d-flex align-items-center
                                justify-content-center
                                mx-auto
                                rounded-circle
                                mb-3"
                         style="
                             width: 64px;
                             height: 64px;
                             background-color: #EDE9FE;
                             color: #7C3AED;">

                        <span class="fs-4">

                            📚

                        </span>

                    </div>


                    <h4 class="fw-bold"
                        style="color: #18181B;">

                        No courses available yet

                    </h4>


                    <p class="mb-0"
                       style="color: #71717A;">

                        New courses will appear here once they are published.

                    </p>

                </div>

            }

        </div>

    </section>


    <!-- =========================
         CTA SECTION
         ========================= -->

    <section class="pb-5">

        <div class="container">

            <div class="rounded-4 p-4 p-md-5 animated-cta"
                 style="
                     background-color: #18181B;
                     color: white;">

                <div class="row align-items-center g-4">

                    <div class="col-12 col-lg-8">

                        <h2 class="fw-bold mb-2">

                            Ready to start learning?

                        </h2>


                        <p class="mb-0"
                           style="color: #D4D4D8;">

                            Create your account and start your learning journey.

                        </p>

                    </div>


                    <div class="col-12 col-lg-4 text-lg-end">

                        @if (!User.Identity?.IsAuthenticated ?? true)
                        {

                            <a asp-controller="Account"
                               asp-action="Register"
                               class="btn px-4 py-3 fw-semibold animated-btn"
                               style="
                                   background-color: #7C3AED;
                                   color: white;
                                   border: none;
                                   border-radius: 10px;">

                                Create Account

                            </a>

                        }

                        else
                        {

                            <a asp-controller="Course"
                               asp-action="Index"
                               class="btn px-4 py-3 fw-semibold animated-btn"
                               style="
                                   background-color: #7C3AED;
                                   color: white;
                                   border: none;
                                   border-radius: 10px;">

                                Browse Courses

                            </a>

                        }

                    </div>

                </div>

            </div>

        </div>

    </section>

</div>