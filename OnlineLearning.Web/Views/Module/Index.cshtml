@model IEnumerable<OnlineLearning.Business.DTOs.ModuleDto>

@{
    ViewData["Title"] = "Course Modules";

    bool isOwner = ViewBag.IsOwner != null && (bool)ViewBag.IsOwner;
}

<style>
    .modules-page {
        background: #FAF7F2;
        min-height: 100vh;
    }

    .module-card {
        background: #FFFFFF;
        border: 1px solid #E4E4E7;
        border-radius: 18px;
        overflow: hidden;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .module-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 25px rgba(24, 24, 27, 0.08);
    }

    .module-number {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: #EDE9FE;
        color: #7C3AED;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .module-title {
        color: #18181B;
        font-weight: 700;
        line-height: 1.4;
    }

    .module-description {
        color: #71717A;
        line-height: 1.7;
    }

    .module-badge {
        background: #EDE9FE;
        color: #5B21B6;
        border-radius: 8px;
        padding: 6px 10px;
        font-size: 12px;
        font-weight: 600;
    }

    .module-footer {
        background: #FFFFFF;
        border-top: 1px solid #E4E4E7;
    }

    .btn-purple {
        background: #7C3AED;
        border-color: #7C3AED;
        color: #FFFFFF;
        border-radius: 10px;
        font-weight: 600;
        padding: 9px 16px;
    }

    .btn-purple:hover {
        background: #5B21B6;
        border-color: #5B21B6;
        color: #FFFFFF;
    }

    .btn-edit {
        background: #F59E0B;
        border-color: #F59E0B;
        color: #FFFFFF;
        border-radius: 10px;
        font-weight: 600;
        padding: 9px 16px;
    }

    .btn-edit:hover {
        background: #D97706;
        border-color: #D97706;
        color: #FFFFFF;
    }

    .btn-delete {
        background: #DC2626;
        border-color: #DC2626;
        color: #FFFFFF;
        border-radius: 10px;
        font-weight: 600;
        padding: 9px 16px;
    }

    .btn-delete:hover {
        background: #B91C1C;
        border-color: #B91C1C;
        color: #FFFFFF;
    }

    .btn-add {
        background: #7C3AED;
        border-color: #7C3AED;
        color: #FFFFFF;
        border-radius: 10px;
        font-weight: 600;
        padding: 10px 18px;
    }

    .btn-add:hover {
        background: #5B21B6;
        border-color: #5B21B6;
        color: #FFFFFF;
    }

    .empty-state {
        background: #FFFFFF;
        border: 1px solid #E4E4E7;
        border-radius: 18px;
    }
</style>

<div class="modules-page py-5">

    <div class="container">

        <!-- Error Message -->
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger rounded-4 mb-4"
                 role="alert">
                @TempData["Error"]
            </div>
        }

        <!-- Header -->
        <div class="d-flex flex-column flex-md-row
                    justify-content-between align-items-md-center
                    gap-3 mb-5">

            <div>

                <h1 class="fw-bold mb-2"
                    style="color: #18181B;">
                    Course Modules
                </h1>

                <p class="mb-0"
                   style="color: #71717A;">
                    Explore the modules of this course and continue your learning journey.
                </p>

            </div>

            @if (isOwner)
            {
                <a asp-action="Create"
                   asp-route-courseId="@ViewBag.CourseId"
                   class="btn btn-add">
                    + Add Module
                </a>
            }

        </div>


        @if (!Model.Any())
        {
            <!-- Empty State -->
            <div class="empty-state text-center py-5 px-4">

                <div class="mb-3"
                     style="font-size: 48px; color: #7C3AED;">
                    📚
                </div>

                <h4 class="fw-bold mb-2"
                    style="color: #18181B;">
                    No Modules Available
                </h4>

                <p class="mb-0"
                   style="color: #71717A;">
                    No modules have been added to this course yet.
                </p>

            </div>
        }
        else
        {
            <!-- Modules Grid -->
            <div class="row g-4">

                @foreach (var module in Model)
                {
                    <div class="col-12 col-md-6">

                        <div class="module-card h-100 d-flex flex-column">

                            <!-- Module Body -->
                            <div class="p-4 flex-grow-1">

                                <div class="d-flex align-items-start gap-3">

                                    <!-- Module Number -->
                                    <div class="module-number">
                                        @module.OrderNumber
                                    </div>


                                    <div class="flex-grow-1">

                                        <div class="d-flex flex-column
                                                    flex-sm-row
                                                    justify-content-between
                                                    align-items-sm-start
                                                    gap-2 mb-3">

                                            <h5 class="module-title mb-0">
                                                @module.Title
                                            </h5>

                                            <span class="module-badge">
                                                Module @module.OrderNumber
                                            </span>

                                        </div>


                                        <p class="module-description mb-0">
                                            @module.Description
                                        </p>

                                    </div>

                                </div>

                            </div>


                            <!-- Footer -->
                            <div class="module-footer p-3">

                                <div class="d-flex flex-wrap gap-2">

                                    <!-- View -->
                                    <a asp-action="Details"
                                       asp-route-id="@module.ModuleId"
                                       class="btn btn-purple">
                                        View Module
                                    </a>


                                    @if (isOwner)
                                    {
                                        <!-- Edit -->
                                        <a asp-action="Edit"
                                           asp-route-id="@module.ModuleId"
                                           class="btn btn-edit">
                                            Edit
                                        </a>


                                        <!-- Delete -->
                                        <form asp-action="Delete"
                                              asp-route-id="@module.ModuleId"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this module?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-delete">
                                                Delete
                                            </button>

                                        </form>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>