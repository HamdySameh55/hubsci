@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="min-vh-100 d-flex align-items-center py-5"
     style="background-color: #FAF7F2;">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-7 col-lg-5">

                <div class="bg-white border rounded-4 p-4 p-md-5 text-center shadow-sm">

                    <div class="d-flex align-items-center
                                justify-content-center
                                rounded-circle
                                mx-auto
                                mb-4"
                         style="
                             width: 80px;
                             height: 80px;
                             background-color: #FEE2E2;
                             color: #DC2626;">

                        <span class="fw-bold fs-1">!</span>

                    </div>

                    <h1 class="fw-bold mb-3"
                        style="color: #18181B;">
                        Oops, something went wrong.
                    </h1>

                    <p class="mb-4"
                       style="color: #71717A;">
                        An error occurred while processing your request.
                    </p>

                    @if (Model.ShowRequestId)
                    {
                        <div class="mx-auto text-start mb-4 px-4 py-3 rounded-3"
                             style="
                                 max-width: 380px;
                                 background-color: #FAF7F2;
                                 border: 1px solid #E4E4E7;">
                            <div class="small fw-semibold mb-1"
                                 style="color: #71717A;">
                                Request ID
                            </div>
                            <code style="color: #18181B;">
                                @Model.RequestId
                            </code>
                        </div>
                    }

                    <div class="rounded-4 p-3 mb-4 text-start"
                         style="
                             background-color: #EDE9FE;
                             color: #5B21B6;">

                        <strong>Development Mode</strong>

                        <div class="mt-1" style="font-size: 14px; line-height: 1.6;">
                            Swapping to <strong>Development</strong> environment
                            will display more detailed information about the
                            error that occurred.
                        </div>

                    </div>

                    <p class="mb-4"
                       style="color: #71717A; font-size: 14px; line-height: 1.6;">
                        <strong>The Development environment shouldn't be enabled
                        for deployed applications.</strong>
                        It can result in displaying sensitive information from
                        exceptions to end users. For local debugging, enable the
                        <strong>ASPNETCORE_ENVIRONMENT</strong> environment variable
                        to <strong>Development</strong> and restart the app.
                    </p>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn px-4 py-2 fw-semibold"
                       style="
                           background-color: #7C3AED;
                           color: white;
                           border: none;
                           border-radius: 10px;">
                        Back to Home
                    </a>

                </div>

            </div>
        </div>
    </div>

</div>