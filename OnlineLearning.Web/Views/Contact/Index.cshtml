@{
    ViewData["Title"] = "Contact Us";
}

<style>

    /* ================================
       CONTACT PAGE ANIMATIONS
    ================================= */

    .contact-header {
        opacity: 0;
        transform: translateY(25px);
        animation: contactFadeUp 0.7s ease forwards;
    }

    .contact-info-card {
        opacity: 0;
        transform: translateX(-35px);
        animation: contactSlideLeft 0.8s ease 0.2s forwards;
        transition: box-shadow 0.3s ease, transform 0.3s ease;
    }

    .contact-form-card {
        opacity: 0;
        transform: translateX(35px);
        animation: contactSlideRight 0.8s ease 0.2s forwards;
        transition: box-shadow 0.3s ease, transform 0.3s ease;
    }

    .contact-info-card:hover,
    .contact-form-card:hover {
        box-shadow: 0 18px 40px rgba(24, 24, 27, 0.08);
    }


    /* ================================
       HEADER
    ================================= */

    .contact-badge {
        opacity: 0;
        transform: scale(0.9);
        animation: badgeIn 0.6s ease 0.1s forwards;
    }

    .contact-title {
        opacity: 0;
        transform: translateY(15px);
        animation: contactFadeUp 0.6s ease 0.25s forwards;
    }

    .contact-description {
        opacity: 0;
        transform: translateY(15px);
        animation: contactFadeUp 0.6s ease 0.4s forwards;
    }


    /* ================================
       CONTACT INFORMATION
    ================================= */

    .contact-item {
        opacity: 0;
        transform: translateX(-15px);
        animation: itemSlideIn 0.6s ease forwards;
    }

    .contact-item:nth-child(2) {
        animation-delay: 0.45s;
    }

    .contact-item:nth-child(3) {
        animation-delay: 0.6s;
    }

    .contact-item:nth-child(4) {
        animation-delay: 0.75s;
    }


    .contact-icon {
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;
    }

    .contact-item:hover .contact-icon {
        transform: scale(1.08);
        box-shadow: 0 8px 18px rgba(24, 24, 27, 0.08);
    }


    /* ================================
       FORM
    ================================= */

    .contact-form-title {
        opacity: 0;
        transform: translateY(15px);
        animation: contactFadeUp 0.6s ease 0.35s forwards;
    }

    .contact-form-item {
        opacity: 0;
        transform: translateY(15px);
        animation: formItemIn 0.6s ease forwards;
    }

    .contact-form-item:nth-of-type(1) {
        animation-delay: 0.5s;
    }

    .contact-form-item:nth-of-type(2) {
        animation-delay: 0.6s;
    }

    .contact-form-item:nth-of-type(3) {
        animation-delay: 0.7s;
    }

    .contact-form-item:nth-of-type(4) {
        animation-delay: 0.8s;
    }


    /* ================================
       INPUT EFFECTS
    ================================= */

    .contact-input {
        transition:
            border-color 0.25s ease,
            box-shadow 0.25s ease,
            transform 0.25s ease;
    }

    .contact-input:focus {
        border-color: #A78BFA !important;

        box-shadow:
            0 0 0 4px rgba(124, 58, 237, 0.10) !important;

        transform: translateY(-1px);
    }


    /* ================================
       BUTTON
    ================================= */

    .contact-submit {
        opacity: 0;
        transform: translateY(15px);

        animation:
            formItemIn 0.6s ease 0.95s forwards;

        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease,
            background-color 0.25s ease;
    }

    .contact-submit:hover {
        background-color: #6D28D9 !important;

        transform: translateY(-2px);

        box-shadow:
            0 10px 25px rgba(124, 58, 237, 0.25);
    }

    .contact-submit:active {
        transform: translateY(0);
    }


    /* ================================
       ANIMATION KEYFRAMES
    ================================= */

    @@keyframes contactFadeUp {

        0% {
            opacity: 0;
            transform: translateY(25px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }

    }


    @@keyframes contactSlideLeft {

        0% {
            opacity: 0;
            transform: translateX(-35px);
        }

        100% {
            opacity: 1;
            transform: translateX(0);
        }

    }


    @@keyframes contactSlideRight {

        0% {
            opacity: 0;
            transform: translateX(35px);
        }

        100% {
            opacity: 1;
            transform: translateX(0);
        }

    }


    @@keyframes badgeIn {

        0% {
            opacity: 0;
            transform: scale(0.9);
        }

        100% {
            opacity: 1;
            transform: scale(1);
        }

    }


    @@keyframes itemSlideIn {

        0% {
            opacity: 0;
            transform: translateX(-15px);
        }

        100% {
            opacity: 1;
            transform: translateX(0);
        }

    }


    @@keyframes formItemIn {

        0% {
            opacity: 0;
            transform: translateY(15px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }

    }


    /* ================================
       MOBILE
    ================================= */

    @@media (max-width: 991px) {

        .contact-info-card,
        .contact-form-card {
            transform: translateY(25px);
        }

        @@keyframes contactSlideLeft {

            0% {
                opacity: 0;
                transform: translateY(25px);
            }

            100% {
                opacity: 1;
                transform: translateY(0);
            }

        }

        @@keyframes contactSlideRight {

            0% {
                opacity: 0;
                transform: translateY(25px);
            }

            100% {
                opacity: 1;
                transform: translateY(0);
            }

        }

    }

</style>


<div class="container py-5">

    <!-- Page Header -->
    <div class="text-center mb-5 contact-header">

        <span class="badge rounded-pill px-3 py-2 mb-3 contact-badge"
              style="
                  background-color: #EDE9FE;
                  color: #7C3AED;
                  font-weight: 600;">
            Get In Touch
        </span>

        <h1 class="display-5 fw-bold contact-title"
            style="color: #18181B;">
            Contact Us
        </h1>

        <p class="mx-auto mt-3 contact-description"
           style="
               max-width: 650px;
               color: #71717A;
               line-height: 1.8;">

            Have a question about a course, enrollment, payment, or your
            learning experience? We'd love to hear from you.

        </p>

    </div>


    <div class="row g-4 justify-content-center">

        <!-- Contact Information -->
        <div class="col-lg-4">

            <div class="h-100 p-4 rounded-4 contact-info-card"
                 style="
                     background-color: white;
                     border: 1px solid #E4E4E7;">

                <h4 class="fw-bold mb-4"
                    style="color: #18181B;">

                    Let's Talk

                </h4>


                <!-- Email -->
                <div class="d-flex gap-3 mb-4 contact-item">

                    <div class="contact-icon"
                         style="
                             min-width: 45px;
                             height: 45px;
                             border-radius: 12px;
                             background-color: #EDE9FE;
                             display: flex;
                             align-items: center;
                             justify-content: center;
                             font-size: 1.2rem;">

                        ✉️

                    </div>

                    <div>

                        <div class="fw-semibold"
                             style="color: #18181B;">

                            Email

                        </div>

                        <div style="color: #71717A;">

                            support@hub-sci.com

                        </div>

                    </div>

                </div>


                <!-- Response Time -->
                <div class="d-flex gap-3 mb-4 contact-item">

                    <div class="contact-icon"
                         style="
                             min-width: 45px;
                             height: 45px;
                             border-radius: 12px;
                             background-color: #DCFCE7;
                             display: flex;
                             align-items: center;
                             justify-content: center;
                             font-size: 1.2rem;">

                        ⏱️

                    </div>

                    <div>

                        <div class="fw-semibold"
                             style="color: #18181B;">

                            Response Time

                        </div>

                        <div style="color: #71717A;">

                            Usually within 24–48 hours

                        </div>

                    </div>

                </div>


                <!-- Support -->
                <div class="d-flex gap-3 contact-item">

                    <div class="contact-icon"
                         style="
                             min-width: 45px;
                             height: 45px;
                             border-radius: 12px;
                             background-color: #FEF3C7;
                             display: flex;
                             align-items: center;
                             justify-content: center;
                             font-size: 1.2rem;">

                        💬

                    </div>

                    <div>

                        <div class="fw-semibold"
                             style="color: #18181B;">

                            Support

                        </div>

                        <div style="color: #71717A;">

                            We're here to help you.

                        </div>

                    </div>

                </div>


                <hr class="my-4"
                    style="border-color: #E4E4E7;" />


                <p class="small mb-0"
                   style="
                       color: #71717A;
                       line-height: 1.7;">

                    Whether you need help with your account, a course,
                    payment, or anything else related to Hub Sci,
                    feel free to send us a message.

                </p>

            </div>

        </div>


        <!-- Contact Form -->
        <div class="col-lg-7">

            <div class="p-4 p-md-5 rounded-4 contact-form-card"
                 style="
                     background-color: white;
                     border: 1px solid #E4E4E7;">

                <h4 class="fw-bold mb-4 contact-form-title"
                    style="color: #18181B;">

                    Send Us a Message

                </h4>


                <form action="https://formspree.io/f/mwlkdzrd"
                      method="POST">


                    <!-- Name -->
                    <div class="mb-3 contact-form-item">

                        <label for="name"
                               class="form-label fw-semibold"
                               style="color: #3F3F46;">

                            Name

                        </label>

                        <input type="text"
                               id="name"
                               name="name"
                               class="form-control contact-input"
                               placeholder="Enter your name"
                               required
                               style="
                                   border-radius: 10px;
                                   padding: 12px;
                                   border-color: #D4D4D8;" />

                    </div>


                    <!-- Email -->
                    <div class="mb-3 contact-form-item">

                        <label for="email"
                               class="form-label fw-semibold"
                               style="color: #3F3F46;">

                            Email

                        </label>

                        <input type="email"
                               id="email"
                               name="email"
                               class="form-control contact-input"
                               placeholder="Enter your email"
                               required
                               style="
                                   border-radius: 10px;
                                   padding: 12px;
                                   border-color: #D4D4D8;" />

                    </div>


                    <!-- Subject -->
                    <div class="mb-3 contact-form-item">

                        <label for="subject"
                               class="form-label fw-semibold"
                               style="color: #3F3F46;">

                            Subject

                        </label>

                        <input type="text"
                               id="subject"
                               name="subject"
                               class="form-control contact-input"
                               placeholder="What is your message about?"
                               required
                               style="
                                   border-radius: 10px;
                                   padding: 12px;
                                   border-color: #D4D4D8;" />

                    </div>


                    <!-- Message -->
                    <div class="mb-4 contact-form-item">

                        <label for="message"
                               class="form-label fw-semibold"
                               style="color: #3F3F46;">

                            Message

                        </label>

                        <textarea id="message"
                                  name="message"
                                  class="form-control contact-input"
                                  rows="6"
                                  placeholder="Write your message here..."
                                  required
                                  style="
                                      border-radius: 10px;
                                      padding: 12px;
                                      border-color: #D4D4D8;
                                      resize: vertical;"></textarea>

                    </div>


                    <!-- Submit -->
                    <button type="submit"
                            class="btn px-4 py-2 fw-semibold contact-submit"
                            style="
                                background-color: #7C3AED;
                                color: white;
                                border: none;
                                border-radius: 10px;">

                        Send Message

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>