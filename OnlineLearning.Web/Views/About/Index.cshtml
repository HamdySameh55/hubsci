@{
    ViewData["Title"] = "About Us";
}

<style>

    /* ================================
       ABOUT PAGE
    ================================= */

    .about-page {
        overflow: hidden;
    }


    /* ================================
       ANIMATIONS
    ================================= */

    .fade-up {
        opacity: 0;
        transform: translateY(30px);
        animation: fadeUp 0.8s ease forwards;
    }

    .fade-up-delay-1 {
        animation-delay: 0.15s;
    }

    .fade-up-delay-2 {
        animation-delay: 0.3s;
    }

    .fade-up-delay-3 {
        animation-delay: 0.45s;
    }

    .fade-up-delay-4 {
        animation-delay: 0.6s;
    }

    @@keyframes fadeUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* ================================
       HERO IMAGE ANIMATION
    ================================= */

    .hero-image-card {
        animation: heroCard 1s ease forwards;
        opacity: 0;
        transform: translateX(40px);
    }

    @@keyframes heroCard {
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }


    .hero-logo {
        animation: floatingLogo 4s ease-in-out infinite;
    }

    @@keyframes floatingLogo {

        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }
    }


    /* ================================
       CARDS
    ================================= */

    .about-card {
        transition: all 0.3s ease;
    }

    .about-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 18px 40px rgba(24, 24, 27, 0.08);
        border-color: #DDD6FE !important;
    }

    .feature-card {
        transition: all 0.3s ease;
    }

    .feature-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 18px 40px rgba(24, 24, 27, 0.08);
        border-color: #DDD6FE !important;
    }


    /* ================================
       ICON BOXES
    ================================= */

    .icon-box {
        width: 52px;
        height: 52px;
        border-radius: 14px;

        display: flex;
        align-items: center;
        justify-content: center;

        position: relative;
        overflow: hidden;

        transition: all 0.3s ease;
    }


    .icon-box i {
        font-size: 1.35rem;
        line-height: 1;
    }


    .icon-box-purple {
        background: #EDE9FE;
        color: #7C3AED;
    }


    .icon-box-green {
        background: #DCFCE7;
        color: #16A34A;
    }


    .icon-box-purple i {
        color: #7C3AED;
    }


    .icon-box-green i {
        color: #16A34A;
    }


    .about-card:hover .icon-box,
    .feature-card:hover .icon-box {
        transform: scale(1.08);
    }


    /* ================================
       HERO
    ================================= */

    .about-hero {
        position: relative;
    }


    .about-badge {
        display: inline-flex;
        align-items: center;

        padding: 9px 16px;

        border-radius: 999px;

        background: #EDE9FE;
        color: #7C3AED;

        font-weight: 700;
        font-size: 0.85rem;

        letter-spacing: 0.2px;
    }


    .about-title {
        font-size: clamp(2.5rem, 5vw, 4.2rem);
        line-height: 1.05;
        letter-spacing: -2px;
    }


    .about-title span {
        color: #7C3AED;
    }


    .hero-description {
        max-width: 650px;
    }


    /* ================================
       HERO VISUAL
    ================================= */

    .hero-visual {
        position: relative;

        border-radius: 28px;

        padding: 50px 30px;

        background:
            radial-gradient(
                circle at top right,
                rgba(124, 58, 237, 0.13),
                transparent 35%
            ),
            linear-gradient(
                135deg,
                #F5F3FF,
                #FAF7F2
            );

        border: 1px solid #E9D5FF;

        box-shadow:
            0 20px 60px rgba(124, 58, 237, 0.08);
    }


    .hero-visual::before {
        content: "";

        position: absolute;

        width: 120px;
        height: 120px;

        border-radius: 50%;

        background: rgba(124, 58, 237, 0.08);

        top: -35px;
        right: -35px;
    }


    .hero-visual img {
        position: relative;
        z-index: 1;
    }


    /* ================================
       SECTION TITLES
    ================================= */

    .section-label {
        color: #7C3AED;

        font-size: 0.8rem;

        font-weight: 800;

        letter-spacing: 2px;
    }


    .section-description {
        max-width: 650px;
    }


    /* ================================
       CTA
    ================================= */

    .about-cta {
        position: relative;

        overflow: hidden;

        border-radius: 28px;

        background:
            radial-gradient(
                circle at 85% 20%,
                rgba(255, 255, 255, 0.14),
                transparent 25%
            ),
            linear-gradient(
                135deg,
                #7C3AED,
                #6D28D9
            );

        box-shadow:
            0 25px 60px rgba(124, 58, 237, 0.22);
    }


    .about-cta::before {
        content: "";

        position: absolute;

        width: 260px;
        height: 260px;

        border: 1px solid rgba(255,255,255,0.12);

        border-radius: 50%;

        right: -100px;
        top: -130px;
    }


    .about-cta::after {
        content: "";

        position: absolute;

        width: 180px;
        height: 180px;

        border: 1px solid rgba(255,255,255,0.1);

        border-radius: 50%;

        left: -80px;
        bottom: -100px;
    }


    .cta-content {
        position: relative;
        z-index: 2;
    }


    .cta-button {
        transition: all 0.3s ease;
    }


    .cta-button:hover {
        transform: translateY(-3px);

        box-shadow:
            0 10px 25px rgba(0,0,0,0.15);
    }


    /* ================================
       MOBILE
    ================================= */

    @@media (max-width: 991px) {

        .about-title {
            font-size: 3rem;
        }

        .hero-visual {
            margin-top: 10px;
        }
    }


    @@media (max-width: 575px) {

        .about-title {
            font-size: 2.5rem;
            letter-spacing: -1px;
        }

        .hero-visual {
            padding: 35px 20px;
        }

        .about-cta {
            border-radius: 22px;
        }
    }

</style>


<div class="container py-5 about-page">


    <!-- =================================
         HERO
    ================================= -->

    <div class="row align-items-center g-5 mb-5 about-hero">


        <!-- LEFT -->

        <div class="col-lg-6">

            <div class="fade-up">

                <span class="about-badge mb-4">

                    About Hub Sci

                </span>

            </div>


            <h1 class="about-title fw-bold mb-4 fade-up fade-up-delay-1"
                style="color: #18181B;">

                Learn. Grow.
                <span>Succeed.</span>

            </h1>


            <p class="lead mb-4 fade-up fade-up-delay-2"
               style="
                   color: #52525B;
                   line-height: 1.8;">

                Hub Sci is an online learning platform designed to make
                high-quality education simple, accessible, and engaging.

            </p>


            <p class="hero-description fade-up fade-up-delay-3"
               style="
                   color: #71717A;
                   line-height: 1.8;">

                We bring students and instructors together in one platform
                where learners can discover courses, learn at their own pace,
                track their progress, complete quizzes, and build their
                knowledge step by step.

            </p>

        </div>


        <!-- RIGHT -->

        <div class="col-lg-6">

            <div class="hero-visual hero-image-card">

                <div class="text-center">


                    <img src="~/images/Gemini_Generated_Image_snsprxsnsprxsnsp-removebg-preview.png"
                         alt="Hub Sci"
                         class="hero-logo"
                         style="
                             max-width: 220px;
                             width: 100%;
                             height: auto;"
                         onerror="this.style.display='none';" />


                    <h3 class="fw-bold mt-4"
                        style="color: #18181B;">

                        Education Made Simple

                    </h3>


                    <p class="mb-0"
                       style="color: #71717A;">

                        A better way to learn, practice, and grow.

                    </p>

                </div>

            </div>

        </div>

    </div>



    <!-- =================================
         MISSION / VISION
    ================================= -->

    <div class="row g-4 mb-5">


        <!-- MISSION -->

        <div class="col-md-6 fade-up">

            <div class="h-100 p-4 p-lg-5 rounded-4 about-card"
                 style="
                     background-color: white;
                     border: 1px solid #E4E4E7;">


                <div class="icon-box icon-box-purple mb-4">

                    <i class="bi bi-bullseye"></i>

                </div>


                <h4 class="fw-bold mb-3"
                    style="color: #18181B;">

                    Our Mission

                </h4>


                <p class="mb-0"
                   style="
                       color: #71717A;
                       line-height: 1.8;">

                    Our mission is to create a learning environment where
                    students can access useful knowledge, practice what they
                    learn, and continuously improve their skills.

                </p>

            </div>

        </div>



        <!-- VISION -->

        <div class="col-md-6 fade-up fade-up-delay-1">

            <div class="h-100 p-4 p-lg-5 rounded-4 about-card"
                 style="
                     background-color: white;
                     border: 1px solid #E4E4E7;">


                <div class="icon-box icon-box-green mb-4">

                    <i class="bi bi-lightbulb"></i>

                </div>


                <h4 class="fw-bold mb-3"
                    style="color: #18181B;">

                    Our Vision

                </h4>


                <p class="mb-0"
                   style="
                       color: #71717A;
                       line-height: 1.8;">

                    We aim to build a modern educational platform that helps
                    learners turn knowledge into real skills and achieve
                    meaningful progress.

                </p>

            </div>

        </div>

    </div>



    <!-- =================================
         WHAT WE OFFER
    ================================= -->

    <div class="text-center mb-5 fade-up">


        <span class="section-label">

            WHAT WE OFFER

        </span>


        <h2 class="fw-bold mt-3 mb-3"
            style="color: #18181B;">

            Everything You Need to Keep Learning

        </h2>


        <p class="mx-auto section-description"
           style="
               color: #71717A;
               line-height: 1.8;">

            Hub Sci provides the tools students need to learn,
            practice, track their progress, and complete their learning journey.

        </p>

    </div>



    <div class="row g-4 mb-5">


        <!-- COURSES -->

        <div class="col-md-4 fade-up">

            <div class="text-center h-100 p-4 p-lg-5 rounded-4 feature-card"
                 style="
                     background-color: white;
                     border: 1px solid #E4E4E7;">


                <div class="icon-box icon-box-purple mx-auto">

                    <i class="bi bi-book"></i>

                </div>


                <h5 class="fw-bold mt-4"
                    style="color: #18181B;">

                    Quality Courses

                </h5>


                <p class="mb-0"
                   style="
                       color: #71717A;
                       line-height: 1.7;">

                    Discover structured courses designed to help you build
                    knowledge step by step.

                </p>

            </div>

        </div>



        <!-- PROGRESS -->

        <div class="col-md-4 fade-up fade-up-delay-1">

            <div class="text-center h-100 p-4 p-lg-5 rounded-4 feature-card"
                 style="
                     background-color: white;
                     border: 1px solid #E4E4E7;">


                <div class="icon-box icon-box-purple mx-auto">

                    <i class="bi bi-bar-chart"></i>

                </div>


                <h5 class="fw-bold mt-4"
                    style="color: #18181B;">

                    Track Your Progress

                </h5>


                <p class="mb-0"
                   style="
                       color: #71717A;
                       line-height: 1.7;">

                    Keep track of completed lessons, quizzes, and your overall
                    learning progress.

                </p>

            </div>

        </div>



        <!-- GOALS -->

        <div class="col-md-4 fade-up fade-up-delay-2">

            <div class="text-center h-100 p-4 p-lg-5 rounded-4 feature-card"
                 style="
                     background-color: white;
                     border: 1px solid #E4E4E7;">


                <div class="icon-box icon-box-purple mx-auto">

                    <i class="bi bi-trophy"></i>

                </div>


                <h5 class="fw-bold mt-4"
                    style="color: #18181B;">

                    Achieve Your Goals

                </h5>


                <p class="mb-0"
                   style="
                       color: #71717A;
                       line-height: 1.7;">

                    Complete your courses, test your knowledge, and celebrate
                    your achievements.

                </p>

            </div>

        </div>

    </div>



    <!-- =================================
         CTA
    ================================= -->

    <div class="about-cta p-4 p-md-5 text-center fade-up">


        <div class="cta-content">


            <h2 class="fw-bold mb-3 text-white">

                Ready to Start Learning?

            </h2>


            <p class="mb-4"
               style="color: #EDE9FE;">

                Explore our courses and take the next step in your learning journey.

            </p>


            <a asp-controller="Course"
               asp-action="Index"
               class="btn px-4 py-2 fw-semibold cta-button"
               style="
                   background-color: white;
                   color: #7C3AED;
                   border: none;
                   border-radius: 10px;">

                Explore Courses

            </a>

        </div>

    </div>

</div>
