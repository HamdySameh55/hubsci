@model IEnumerable<OnlineLearning.Business.DTOs.LessonProgressDto>

@{
    ViewData["Title"] = "My Lesson Progress";
}

<div class="min-vh-100 py-5"
     style="background-color: #FAF7F2;">

    <div class="container">

        <!-- Header -->
        <div class="mb-5">

            <div class="d-flex align-items-center gap-3 mb-3">

                <div class="d-flex align-items-center
                            justify-content-center rounded-3"
                     style="
                         width: 52px;
                         height: 52px;
                         background-color: #EDE9FE;
                         color: #7C3AED;
                     ">

                    <span class="fw-bold fs-4">
                        ✓
                    </span>

                </div>

                <div>
                    <h1 class="fw-bold mb-1"
                        style="
                            color: #18181B;
                            letter-spacing: -0.5px;
                        ">
                        My Lesson Progress
                    </h1>

                    <p class="mb-0"
                       style="color: #71717A;">
                        Track the lessons you have completed.
                    </p>
                </div>

            </div>

        </div>


        <!-- Error Message -->
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger rounded-4 mb-4"
                 role="alert">
                @TempData["Error"]
            </div>
        }


        <!-- Success Message -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success rounded-4 mb-4"
                 role="alert">
                @TempData["Success"]
            </div>
        }


        @if (Model == null || !Model.Any())
        {
            <!-- Empty State -->
            <div class="bg-white rounded-4 shadow-sm p-5 text-center">

                <div class="d-flex align-items-center
                            justify-content-center rounded-circle mx-auto mb-4"
                     style="
                         width: 72px;
                         height: 72px;
                         background-color: #EDE9FE;
                         color: #7C3AED;
                     ">

                    <span class="fw-bold fs-3">
                        ✓
                    </span>

                </div>

                <h3 class="fw-bold mb-2"
                    style="color: #18181B;">
                    No Progress Yet
                </h3>

                <p class="mb-4"
                   style="color: #71717A;">
                    You have not completed any lessons yet.
                </p>

                <a asp-controller="Course"
                   asp-action="Index"
                   class="btn px-4 py-2 fw-semibold text-white"
                   style="
                       background-color: #7C3AED;
                       border: none;
                       border-radius: 10px;
                   ">
                    Browse Courses
                </a>

            </div>
        }
        else
        {
            <!-- Progress List -->
            <div class="row g-4">

                @foreach (var progress in Model)
                {
                    <div class="col-12 col-md-6 col-xl-4">

                        <div class="bg-white border-0 rounded-4 shadow-sm h-100 p-4">

                            <!-- Course -->
                            <div class="mb-4">

                                <div class="small mb-2"
                                     style="color: #71717A;">
                                    Course
                                </div>

                                <h5 class="fw-bold mb-0"
                                    style="color: #18181B;">
                                    @(string.IsNullOrWhiteSpace(progress.CourseTitle)
                                        ? "Course"
                                        : progress.CourseTitle)
                                </h5>

                            </div>


                            <!-- Lesson -->
                            <div class="mb-4">

                                <div class="small mb-2"
                                     style="color: #71717A;">
                                    Lesson
                                </div>

                                <div class="fw-semibold"
                                     style="color: #3F3F46;">
                                    @(string.IsNullOrWhiteSpace(progress.LessonTitle)
                                        ? "Lesson"
                                        : progress.LessonTitle)
                                </div>

                            </div>


                            <!-- Status -->
                            <div class="d-flex align-items-center
                                        justify-content-between
                                        gap-3 mb-4">

                                <span class="small"
                                      style="color: #71717A;">
                                    Status
                                </span>

                                @if (progress.IsCompleted)
                                {
                                    <span class="badge rounded-pill px-3 py-2"
                                          style="
                                              background-color: #DCFCE7;
                                              color: #16A34A;
                                              font-weight: 600;
                                          ">
                                        Completed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-3 py-2"
                                          style="
                                              background-color: #FEF3C7;
                                              color: #92400E;
                                              font-weight: 600;
                                          ">
                                        In Progress
                                    </span>
                                }

                            </div>


                            <!-- Completed Date -->
                            <div class="border-top pt-3 mb-4"
                                 style="
                                     border-color: #E4E4E7 !important;
                                 ">

                                <div class="small"
                                     style="color: #71717A;">

                                    Completed At

                                </div>

                                <div class="fw-semibold mt-1"
                                     style="color: #3F3F46;">

                                    @if (progress.CompletedAt.HasValue)
                                    {
                                        @progress.CompletedAt.Value.ToLocalTime().ToString("dd MMMM yyyy")
                                            
                                    }
                                    else
                                    {
                                        <span>Not completed yet</span>
                                    }

                                </div>

                            </div>


                            <!-- Action -->
                            <a asp-action="Details"
                               asp-route-id="@progress.ProgressId"
                               class="btn w-100 px-4 py-2 fw-semibold"
                               style="
                                   background-color: #EDE9FE;
                                   color: #5B21B6;
                                   border: 1px solid #DDD6FE;
                                   border-radius: 10px;
                               ">
                                View Details
                            </a>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>