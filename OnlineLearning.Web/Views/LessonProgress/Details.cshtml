@model OnlineLearning.Business.DTOs.LessonProgressDto

@{
    ViewData["Title"] = "Lesson Progress Details";
}

<div class="min-vh-100 py-5"
     style="background-color: #FAF7F2;">

    <div class="container">

        <!-- Back -->
        <div class="mb-4">

            <a asp-action="Index"
               class="text-decoration-none fw-semibold"
               style="color: #7C3AED;">

                ← Back to My Progress

            </a>

        </div>


        <!-- Header -->
        <div class="mb-5">

            <div class="d-flex align-items-center gap-3">

                <div class="d-flex align-items-center justify-content-center rounded-3"
                     style="
                         width: 52px;
                         height: 52px;
                         background-color: #EDE9FE;
                         color: #7C3AED;
                     ">

                    <span class="fw-bold fs-4">
                        ✓
                    </span>

                </div>


                <div>

                    <h1 class="fw-bold mb-1"
                        style="
                            color: #18181B;
                            letter-spacing: -0.5px;
                        ">

                        Lesson Progress

                    </h1>


                    <p class="mb-0"
                       style="color: #71717A;">

                        View your lesson completion details.

                    </p>

                </div>

            </div>

        </div>


        <!-- Main Card -->
        <div class="row justify-content-center">

            <div class="col-12 col-lg-8">

                <div class="bg-white rounded-4 shadow-sm p-4 p-md-5">


                    <!-- Course -->
                    <div class="mb-4">

                        <div class="small mb-2"
                             style="color: #71717A;">

                            Course

                        </div>


                        <h3 class="fw-bold mb-0"
                            style="color: #18181B;">

                            @(string.IsNullOrWhiteSpace(Model.CourseTitle)
                                ? "Course"
                                : Model.CourseTitle)

                        </h3>

                    </div>


                    <!-- Lesson -->
                    <div class="mb-4">

                        <div class="small mb-2"
                             style="color: #71717A;">

                            Lesson

                        </div>


                        <div class="fw-semibold fs-5"
                             style="color: #3F3F46;">

                            @(string.IsNullOrWhiteSpace(Model.LessonTitle)
                                ? "Lesson"
                                : Model.LessonTitle)

                        </div>

                    </div>


                    <!-- Status -->
                    <div class="mb-4">

                        <div class="small mb-2"
                             style="color: #71717A;">

                            Status

                        </div>


                        @if (Model.IsCompleted)
                        {
                            <span class="badge rounded-pill px-3 py-2"
                                  style="
                                      background-color: #DCFCE7;
                                      color: #16A34A;
                                      font-weight: 600;
                                  ">

                                ✓ Completed

                            </span>
                        }
                        else
                        {
                            <span class="badge rounded-pill px-3 py-2"
                                  style="
                                      background-color: #FEF3C7;
                                      color: #92400E;
                                      font-weight: 600;
                                  ">

                                In Progress

                            </span>
                        }

                    </div>


                    <!-- Completed At -->
                    <div class="border-top pt-4 mb-4"
                         style="
                             border-color: #E4E4E7 !important;
                         ">

                        <div class="small mb-2"
                             style="color: #71717A;">

                            Completed At

                        </div>


                        <div class="fw-semibold"
                             style="color: #3F3F46;">

                            @if (Model.CompletedAt.HasValue)
                            {
                                @(Model.CompletedAt.Value.ToLocalTime().ToString("dd MMMM yyyy"))
                            }
                            else
                            {
                                <span>
                                    Not completed yet
                                </span>
                            }

                        </div>

                    </div>


                    <!-- IDs -->
                    <div class="border-top pt-4">

                        <div class="row g-4">


                            <!-- Enrollment ID -->
                            <div class="col-12 col-md-6">

                                <div class="small mb-2"
                                     style="color: #71717A;">

                                    Enrollment ID

                                </div>


                                <div class="fw-semibold"
                                     style="color: #3F3F46;">

                                    #@Model.EnrollmentId

                                </div>

                            </div>


                            <!-- Lesson ID -->
                            <div class="col-12 col-md-6">

                                <div class="small mb-2"
                                     style="color: #71717A;">

                                    Lesson ID

                                </div>


                                <div class="fw-semibold"
                                     style="color: #3F3F46;">

                                    #@Model.LessonId

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- Action -->
                    <div class="mt-5">

                        <a asp-action="Index"
                           class="btn w-100 py-2 fw-semibold"
                           style="
                               background-color: #7C3AED;
                               color: white;
                               border: none;
                               border-radius: 10px;
                           ">

                            Back to My Progress

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>