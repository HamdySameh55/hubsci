@model IEnumerable<OnlineLearning.Business.DTOs.CourseDto>

@{
    ViewData["Title"] = "Course Management";
}

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1" style="color: #18181B;">
                Course Management
            </h1>

            <p class="mb-0" style="color: #71717A;">
                View and manage all courses on the platform.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Dashboard"
           class="btn"
           style="
               background-color: #EDE9FE;
               color: #5B21B6;
               border: 1px solid #DDD6FE;
           ">
            Back to Dashboard
        </a>

    </div>


    <!-- Courses Table -->
    <div class="card border-0 shadow-sm"
         style="
             border-radius: 16px;
             overflow: hidden;
             background-color: #FFFFFF;
         ">

        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <div class="mb-3"
                         style="
                             width: 60px;
                             height: 60px;
                             margin: 0 auto;
                             border-radius: 50%;
                             background-color: #EDE9FE;
                             display: flex;
                             align-items: center;
                             justify-content: center;
                             color: #7C3AED;
                             font-size: 24px;
                         ">
                        📚
                    </div>

                    <h5 class="fw-bold" style="color: #18181B;">
                        No Courses Found
                    </h5>

                    <p class="mb-0" style="color: #71717A;">
                        There are currently no courses on the platform.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead style="background-color: #FAF7F2;">

                            <tr>
                                <th class="px-4 py-3"
                                    style="color: #52525B;">
                                    Course
                                </th>

                                <th class="py-3"
                                    style="color: #52525B;">
                                    Instructor
                                </th>

                                <th class="py-3"
                                    style="color: #52525B;">
                                    Price
                                </th>

                                <th class="py-3"
                                    style="color: #52525B;">
                                    Status
                                </th>

                                <th class="text-end px-4 py-3"
                                    style="color: #52525B;">
                                    Actions
                                </th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var course in Model)
                            {
                                <tr>

                                    <!-- Course -->
                                    <td class="px-4 py-3">

                                        <div class="fw-semibold"
                                             style="color: #18181B;">
                                            @course.Title
                                        </div>

                                        <div class="small"
                                             style="color: #71717A;">
                                            Course ID: @course.CourseId
                                        </div>

                                    </td>


                                    <!-- Instructor -->
                                    <td class="py-3">

                                        <span style="color: #52525B;">
                                            Instructor #@course.InstructorId
                                        </span>

                                    </td>


                                    <!-- Price -->
                                    <td class="py-3">

                                        <span class="fw-semibold"
                                              style="color: #18181B;">
                                            @course.Price.ToString("0.00")
                                        </span>

                                    </td>


                                    <!-- Status -->
                                    <td class="py-3">

                                        @if (course.Status == "Published")
                                        {
                                            <span class="badge px-3 py-2"
                                                  style="
                                                      background-color: #DCFCE7;
                                                      color: #166534;
                                                  ">
                                                Published
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge px-3 py-2"
                                                  style="
                                                      background-color: #FEF3C7;
                                                      color: #92400E;
                                                  ">
                                                @course.Status
                                            </span>
                                        }

                                    </td>


                                    <!-- Actions -->
                                    <td class="text-end px-4 py-3">

                                        <div class="d-flex justify-content-end gap-2">

                                            <a asp-controller="Module"
                                               asp-action="Index"
                                               asp-route-courseId="@course.CourseId"
                                               class="btn btn-sm"
                                               style="
                                                   background-color: #EDE9FE;
                                                   color: #5B21B6;
                                                   border: 1px solid #DDD6FE;
                                               ">
                                                View
                                            </a>


                                            <form asp-controller="Admin"
                                                  asp-action="DeleteCourse"
                                                  asp-route-id="@course.CourseId"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this course? This action cannot be undone.');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm"
                                                        style="
                                                            background-color: #FEE2E2;
                                                            color: #B91C1C;
                                                            border: 1px solid #FECACA;
                                                        ">
                                                    Delete
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>