
@model OnlineLearning.Business.DTOs.CreateCourseDto

@{
    ViewData["Title"] = "Edit Course";
}

<div class="min-vh-100 py-5"
     style="background-color: #FAF7F2;">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-12 col-md-9 col-lg-7 col-xl-6">

                <!-- Edit Course Card -->
                <div class="bg-white border rounded-4 shadow-sm p-4 p-md-5">

                    <!-- Header -->
                    <div class="mb-4">

                        <div class="d-inline-flex align-items-center
                                    justify-content-center rounded-3 mb-3"
                             style="
                                 width: 52px;
                                 height: 52px;
                                 background-color: #EDE9FE;
                                 color: #7C3AED;
                             ">

                            <span class="fw-bold fs-4">
                                ✎
                            </span>

                        </div>

                        <h1 class="fw-bold mb-2"
                            style="color: #18181B;">
                            Edit Course
                        </h1>

                        <p class="mb-0"
                           style="color: #71717A;">
                            Update your course information and keep
                            your content up to date.
                        </p>

                    </div>


                    <!-- Validation -->
                    <div asp-validation-summary="ModelOnly"
                         class="text-danger small mb-4">
                    </div>


                    <!-- Form -->
                    <form asp-action="Edit" method="post">

                        <!-- Course Title -->
                        <div class="mb-4">

                            <label asp-for="Title"
                                   class="form-label fw-semibold"
                                   style="color: #18181B;">
                            </label>

                            <input asp-for="Title"
                                   class="form-control form-control-lg"
                                   placeholder="Enter course title"
                                   style="
                                       border-color: #E4E4E7;
                                       border-radius: 10px;
                                   " />

                            <span asp-validation-for="Title"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Description -->
                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="form-label fw-semibold"
                                   style="color: #18181B;">
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="6"
                                      placeholder="Describe what students will learn..."
                                      style="
                                          border-color: #E4E4E7;
                                          border-radius: 10px;
                                          resize: vertical;
                                      "></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Price -->
                        <div class="mb-4">

                            <label asp-for="Price"
                                   class="form-label fw-semibold"
                                   style="color: #18181B;">
                            </label>

                            <div class="input-group">

                                <input asp-for="Price"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control form-control-lg"
                                       placeholder="0.00"
                                       style="
                                           border-color: #E4E4E7;
                                           border-radius: 10px 0 0 10px;
                                       " />

                                <span class="input-group-text"
                                      style="
                                          background-color: #FAFAFA;
                                          border-color: #E4E4E7;
                                          color: #71717A;
                                          border-radius: 0 10px 10px 0;
                                      ">
                                    $
                                </span>

                            </div>

                            <span asp-validation-for="Price"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Actions -->
                        <div class="d-flex flex-column flex-sm-row
                                    gap-2 pt-2">

                            <button type="submit"
                                    class="btn flex-grow-1 py-2 fw-semibold text-white"
                                    style="
                                        background-color: #7C3AED;
                                        border-radius: 10px;
                                        border: none;
                                    ">
                                Save Changes
                            </button>

                            <a asp-action="Index"
                               class="btn py-2 px-4 fw-semibold"
                               style="
                                   background-color: #FFFFFF;
                                   color: #7C3AED;
                                   border: 1px solid #7C3AED;
                                   border-radius: 10px;
                               ">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>


                <!-- Footer -->
                <p class="text-center small mt-4 mb-0"
                   style="color: #71717A;">
                    Keep your course content fresh and engaging.
                </p>

            </div>

        </div>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}

