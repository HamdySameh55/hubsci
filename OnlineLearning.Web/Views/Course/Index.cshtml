
@model IEnumerable<OnlineLearning.Business.DTOs.CourseDto>

@{
    ViewData["Title"] = "Courses";
}

<style>
    .courses-page {
        background: #FAF7F2;
        min-height: 100vh;
    }

    .course-card {
        border: 1px solid #E4E4E7;
        border-radius: 18px;
        background: #FFFFFF;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        overflow: hidden;
    }

    .course-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 25px rgba(24, 24, 27, 0.08);
    }

    .course-visual {
        height: 150px;
        background: #EDE9FE;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #7C3AED;
        font-size: 48px;
        font-weight: 700;
    }

    .course-title {
        color: #18181B;
        font-weight: 700;
        line-height: 1.4;
    }

    .course-description {
        color: #71717A;
        line-height: 1.7;
    }

    .course-price {
        color: #5B21B6;
        font-size: 18px;
        font-weight: 700;
    }

    .course-footer {
        border-top: 1px solid #E4E4E7;
        background: #FFFFFF;
    }

    .btn-purple {
        background: #7C3AED;
        border-color: #7C3AED;
        color: #FFFFFF;
        border-radius: 10px;
        font-weight: 600;
        padding: 10px 18px;
    }

    .btn-purple:hover {
        background: #5B21B6;
        border-color: #5B21B6;
        color: #FFFFFF;
    }

    .btn-outline-purple {
        background: #FFFFFF;
        border: 1px solid #7C3AED;
        color: #7C3AED;
        border-radius: 10px;
        font-weight: 600;
        padding: 9px 16px;
    }

    .btn-outline-purple:hover {
        background: #7C3AED;
        border-color: #7C3AED;
        color: #FFFFFF;
    }

    .btn-edit {
        background: #F59E0B;
        border-color: #F59E0B;
        color: #FFFFFF;
        border-radius: 10px;
        font-weight: 600;
    }

    .btn-edit:hover {
        background: #D97706;
        border-color: #D97706;
        color: #FFFFFF;
    }

    .status-badge {
        background: #DCFCE7;
        color: #16A34A;
        border-radius: 8px;
        padding: 6px 10px;
        font-size: 12px;
        font-weight: 600;
    }

    .empty-state {
        background: #FFFFFF;
        border: 1px solid #E4E4E7;
        border-radius: 18px;
    }
</style>

<div class="courses-page py-5">

    <div class="container">

        <!-- Error Message -->
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger rounded-4 mb-4"
                 role="alert">
                @TempData["Error"]
            </div>
        }

        <!-- Header -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-5">

            <div>
                <h1 class="fw-bold mb-2" style="color: #18181B;">
                    Explore Courses
                </h1>

                <p class="mb-0" style="color: #71717A;">
                    Browse our available courses and start learning today.
                </p>
            </div>

            @if (User.IsInRole("Instructor"))
            {
                <a asp-action="Create"
                   class="btn btn-purple">
                    + Create Course
                </a>
            }

        </div>


        @if (!Model.Any())
        {
            <!-- Empty State -->
            <div class="empty-state text-center py-5 px-4">

                <div class="mb-3"
                     style="font-size: 48px; color: #7C3AED;">
                    📚
                </div>

                <h4 class="fw-bold mb-2"
                    style="color: #18181B;">
                    No Courses Available
                </h4>

                <p class="mb-0"
                   style="color: #71717A;">
                    No published courses are available yet.
                    Check back later for new courses.
                </p>

            </div>
        }
        else
        {
            <!-- Courses Grid -->
            <div class="row g-4">

                @foreach (var course in Model)
                {
                    <div class="col-12 col-md-6 col-lg-4">

                        <div class="course-card h-100 d-flex flex-column">

                            <!-- Course Visual -->
                            <div class="course-visual">
                                @course.Title.Substring(0, 1).ToUpper()
                            </div>


                            <!-- Course Body -->
                            <div class="p-4 flex-grow-1">

                                <div class="d-flex justify-content-between align-items-start gap-2 mb-3">

                                    <h5 class="course-title mb-0">
                                        @course.Title
                                    </h5>

                                    <span class="status-badge">
                                        @course.Status
                                    </span>

                                </div>


                                <p class="course-description mb-4">
                                    @(course.Description?.Length > 120
                                        ? course.Description.Substring(0, 120) + "..."
                                        : course.Description)
                                </p>


                                <div class="d-flex justify-content-between align-items-center">

                                    <div>
                                        <small style="color: #71717A;">
                                            Price
                                        </small>

                                        <div class="course-price">
                                            @course.Price
                                        </div>
                                    </div>

                                </div>

                            </div>


                            <!-- Course Footer -->
                            <div class="course-footer p-3">

                                <div class="d-flex gap-2 flex-wrap">

                                    <a asp-action="Details"
                                       asp-route-id="@course.CourseId"
                                       class="btn btn-outline-purple">
                                        Details
                                    </a>


                                    @if (User.IsInRole("Instructor")
                                         && course.InstructorId ==
                                            int.Parse(User.FindFirst(
                                                System.Security.Claims.ClaimTypes.NameIdentifier
                                            )!.Value))
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@course.CourseId"
                                           class="btn btn-edit">
                                            Edit
                                        </a>


                                        @if (course.Status == "Draft")
                                        {
                                            <form asp-action="Publish"
                                                  asp-route-id="@course.CourseId"
                                                  method="post"
                                                  class="d-inline">

                                                <button type="submit"
                                                        class="btn btn-success">
                                                    Publish
                                                </button>

                                            </form>
                                        }


                                        <form asp-action="Delete"
                                              asp-route-id="@course.CourseId"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this course?');">

                                            <button type="submit"
                                                    class="btn btn-danger">
                                                Delete
                                            </button>

                                        </form>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>
