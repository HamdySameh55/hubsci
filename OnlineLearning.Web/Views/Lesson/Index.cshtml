@model IEnumerable<OnlineLearning.Business.DTOs.LessonDto>

@{
ViewData["Title"] = "Lessons";
}

<style>
    .lessons-page {
        background-color: #FAF7F2;
        min-height: 100vh;
    }

    .lesson-card {
        background-color: #FFFFFF;
        border: 1px solid #E4E4E7;
        border-radius: 20px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .lesson-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(24, 24, 27, 0.08) !important;
    }

    .lesson-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background-color: #EDE9FE;
        color: #7C3AED;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        font-weight: 700;
    }

    .lesson-title {
        color: #18181B;
    }

    .lesson-description {
        color: #71717A;
        line-height: 1.7;
    }

    .lesson-meta {
        color: #A1A1AA;
    }

    .content-badge {
        background-color: #EDE9FE;
        color: #5B21B6;
        font-weight: 600;
        border-radius: 999px;
    }

    .btn-purple {
        background-color: #7C3AED;
        border: 1px solid #7C3AED;
        color: #FFFFFF;
        border-radius: 10px;
        font-weight: 600;
        padding: 10px 16px;
    }

    .btn-purple:hover {
        background-color: #5B21B6;
        border-color: #5B21B6;
        color: #FFFFFF;
    }

    .empty-card {
        background-color: #FFFFFF;
        border: 1px solid #E4E4E7;
        border-radius: 20px;
    }

    .empty-icon {
        width: 64px;
        height: 64px;
        border-radius: 18px;
        background-color: #EDE9FE;
        color: #7C3AED;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        font-weight: 700;
    }
</style>

<div class="lessons-page py-5">

<div class="container">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center
                gap-3 mb-4">

        <div>
            <h1 class="fw-bold mb-1 lesson-title">
                Lessons
            </h1>

            <p class="mb-0"
               style="color: #71717A;">
                Explore the lessons available in this module.
            </p>
        </div>

    </div>

    @if (!Model.Any())
    {
        <!-- Empty State -->
        <div class="empty-card shadow-sm p-5 text-center">

            <div class="empty-icon mx-auto mb-3">
                L
            </div>

            <h4 class="fw-bold mb-2 lesson-title">
                No lessons yet
            </h4>

            <p class="mb-0"
               style="color: #71717A;">
                This module does not have any lessons yet.
            </p>

        </div>
    }
    else
    {
        <!-- Lessons -->
        <div class="row g-4">

            @foreach (var lesson in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">

                    <div class="lesson-card shadow-sm h-100 p-4">

                        <!-- Card Header -->
                        <div class="d-flex
                                    justify-content-between
                                    align-items-start
                                    mb-3">

                            <div class="lesson-icon">
                                L
                            </div>

                            <span class="badge content-badge px-3 py-2">
                                @lesson.ContentType
                            </span>

                        </div>

                        <!-- Title -->
                        <h5 class="fw-bold mb-2 lesson-title">
                            @lesson.Title
                        </h5>

                        <!-- Description -->
                        <p class="small mb-3 lesson-description">
                            @lesson.Description
                        </p>

                        <!-- Meta -->
                        <div class="small mb-4 lesson-meta">
                            Module ID: @lesson.ModuleId
                        </div>

                        <!-- Action -->
                        <a asp-action="Details"
                           asp-route-id="@lesson.LessonId"
                           class="btn btn-purple w-100">
                            View Lesson
                        </a>

                    </div>

                </div>
            }

        </div>
    }

</div>


</div>
