@model OnlineLearning.Business.DTOs.PaymentDto

@{
    ViewData["Title"] = "Pay with InstaPay";
    var awaitingProof = Model.TransactionReference == null;
}

<div class="container py-5">

    <div class="mb-4">
        <a asp-controller="Enrollment"
           asp-action="Details"
           asp-route-id="@Model.EnrollmentId"
           class="text-decoration-none"
           style="color: #7C3AED;">
            ← Back to Enrollment
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="card border-0 shadow-sm"
                 style="border-radius: 20px; overflow: hidden;">

                <div class="p-4"
                     style="background: #7C3AED; color: white;">

                    <h2 class="mb-1 fw-bold">
                        Pay with InstaPay
                    </h2>

                    <p class="mb-0 opacity-75">
                        @Model.CourseTitle
                    </p>

                </div>

                <div class="card-body p-4 p-md-5">

                    @if (Model.PaymentStatus == "Successful")
                    {
                        <div class="text-center mb-4">

                            <div class="d-flex align-items-center justify-content-center
                                        rounded-circle mx-auto mb-3"
                                 style="width: 64px; height: 64px; background: #DCFCE7;
                                        color: #166534; font-size: 1.6rem;">
                                ✓
                            </div>

                            <h4 class="fw-bold mb-2" style="color: #166534;">
                                Payment Verified
                            </h4>

                            <p class="text-muted mb-0">
                                Your payment has been approved and your
                                enrollment is now active.
                            </p>

                        </div>

                        <a asp-controller="Module"
                           asp-action="Index"
                           asp-route-courseId="@Model.CourseId"
                           class="btn w-100 text-white py-2 fw-semibold"
                           style="background: #7C3AED; border-radius: 10px;">
                            Start Learning
                        </a>
                    }
                    else if (Model.PaymentStatus == "Pending" && !awaitingProof)
                    {
                        <div class="text-center mb-4">

                            <div class="d-flex align-items-center justify-content-center
                                        rounded-circle mx-auto mb-3"
                                 style="width: 64px; height: 64px; background: #FEF3C7;
                                        color: #92400E; font-size: 1.5rem;">
                                ⌛
                            </div>

                            <h4 class="fw-bold mb-2" style="color: #92400E;">
                                Waiting for Verification
                            </h4>

                            <p class="text-muted mb-0">
                                Your payment proof has been submitted and is
                                awaiting instructor verification. Enrollment
                                will activate automatically once approved.
                            </p>

                        </div>

                        <div class="border rounded-4 p-4"
                             style="border-color: #E4E4E7 !important;">

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-muted small">Transaction Reference</span>
                                <span class="fw-semibold">@Model.TransactionReference</span>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.ProofFilePath))
                            {
                                <div class="mb-1 text-muted small">
                                    Your Screenshot
                                </div>
                                <img src="@Model.ProofFilePath"
                                     alt="Payment proof"
                                     class="img-fluid rounded-3 border mb-3"
                                     style="max-height: 260px; object-fit: cover;" />
                            }

                        </div>
                    }
                    else if (Model.PaymentStatus == "Failed")
                    {
                        <div class="text-center mb-4">

                            <div class="d-flex align-items-center justify-content-center
                                        rounded-circle mx-auto mb-3"
                                 style="width: 64px; height: 64px; background: #FEE2E2;
                                        color: #991B1B; font-size: 1.5rem;">
                                ✕
                            </div>

                            <h4 class="fw-bold mb-2" style="color: #991B1B;">
                                Payment Rejected
                            </h4>

                            <p class="text-muted mb-0">
                                The instructor could not verify your submission.
                                Please check your transaction details and try
                                again with a correct screenshot.
                            </p>

                        </div>
                    }

                    @if (Model.PaymentStatus == "Successful")
                    {
                        <a asp-controller="Enrollment"
                           asp-action="Details"
                           asp-route-id="@Model.EnrollmentId"
                           class="btn w-100 mt-2 fw-semibold py-2"
                           style="background: white; color: #7C3AED;
                                  border: 1px solid #7C3AED; border-radius: 10px;">
                            Back to Enrollment
                        </a>
                    }
                    else if (Model.PaymentStatus == "Pending" && awaitingProof)
                    {
                        <div class="rounded-4 p-4 mb-4"
                             style="background: #EDE9FE; color: #52525B;">

                            <div class="fw-semibold mb-2" style="color: #7C3AED;">
                                How to pay with InstaPay
                            </div>

                            <ol class="mb-0 ps-3 small">
                                <li>Open your InstaPay app and transfer
                                    <strong>@Model.Amount.ToString("N2") EGP</strong>
                                    to <strong>habibaatia38@instapay</strong>.</li>
                                <li>Take a screenshot of the successful transfer.</li>
                                <li>Enter the transaction reference from your
                                    receipt and upload the screenshot below.</li>
                                <li>Your enrollment activates once the instructor
                                    verifies the payment.</li>
                            </ol>

                        </div>

                        <a href="https://ipn.eg/S/habibaatia38/instapay/6rma4q"
                           target="_blank"
                           rel="noopener"
                           class="btn w-100 text-white py-2 fw-semibold mb-4"
                           style="background: #7C3AED; border-radius: 10px;">
                            Open InstaPay Payment Link
                        </a>

                        <form asp-controller="Payment"
                              asp-action="SubmitProof"
                              method="post"
                              enctype="multipart/form-data"
                              class="border rounded-4 p-4"
                              style="border-color: #E4E4E7 !important;">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="PaymentId"
                                   value="@Model.PaymentId" />
                            <input type="hidden"
                                   name="EnrollmentId"
                                   value="@Model.EnrollmentId" />

                            <div class="mb-3">
                                <label class="form-label fw-semibold small"
                                       for="TransactionReference">
                                    Transaction Reference
                                </label>
                                <input type="text"
                                       class="form-control"
                                       id="TransactionReference"
                                       name="TransactionReference"
                                       placeholder="e.g. T2341-8895-ATY765"
                                       required />
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold small"
                                       for="ProofFile">
                                    Payment Screenshot
                                </label>
                                <input type="file"
                                       class="form-control"
                                       id="ProofFile"
                                       name="ProofFile"
                                       accept=".jpg,.jpeg,.png,.gif,.webp"
                                       required />
                                <div class="form-text">
                                    JPG, PNG, GIF or WebP — max 5 MB.
                                </div>
                            </div>

                            <button type="submit"
                                    class="btn w-100 text-white py-2 fw-semibold"
                                    style="background: #7C3AED; border-radius: 10px;">
                                Submit Payment Proof
                            </button>

                        </form>
                    }
                    else if (Model.PaymentStatus == "Failed")
                    {
                        <a asp-controller="Payment"
                           asp-action="Details"
                           asp-route-enrollmentId="@Model.EnrollmentId"
                           class="btn w-100 text-white py-2 fw-semibold"
                           style="background: #7C3AED; border-radius: 10px;">
                            Retry Payment Submission
                        </a>
                    }

                </div>

            </div>

        </div>
    </div>

</div>