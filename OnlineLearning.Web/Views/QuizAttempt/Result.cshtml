@model OnlineLearning.Business.DTOs.QuizAttemptDto

@{
ViewData["Title"] = "Quiz Result";


var score = Model.Score;
var passed = Model.Passed;


}

<style>
    .result-page {
        background-color: #FAF7F2;
        min-height: 100vh;
    }

    .result-card {
        background-color: #FFFFFF;
        border: 1px solid #E4E4E7;
        border-radius: 20px;
        overflow: hidden;
    }

    .result-header {
        background-color: #EDE9FE;
        border-bottom: 1px solid #DDD6FE;
    }

    .result-icon {
        width: 72px;
        height: 72px;
        border-radius: 18px;
        background-color: #FFFFFF;
        color: #7C3AED;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        font-weight: 700;
        margin: 0 auto 20px;
    }

    .result-title {
        color: #18181B;
    }

    .result-description {
        color: #52525B;
        line-height: 1.7;
    }

    .score-box {
        background-color: #FFFFFF;
        border: 1px solid #E4E4E7;
        border-radius: 16px;
        padding: 30px;
        text-align: center;
    }

    .score-label {
        color: #71717A;
        font-size: 14px;
        font-weight: 500;
        margin-bottom: 8px;
    }

    .score {
        color: #7C3AED;
        font-size: 48px;
        line-height: 1.1;
        font-weight: 700;
    }

    .status-badge {
        display: inline-block;
        padding: 8px 18px;
        border-radius: 999px;
        font-weight: 600;
        font-size: 14px;
    }

    .status-passed {
        background-color: #DCFCE7;
        color: #166534;
    }

    .status-failed {
        background-color: #FEE2E2;
        color: #991B1B;
    }

    .info-box {
        background-color: #FFFFFF;
        border: 1px solid #E4E4E7;
        border-radius: 14px;
    }

    .info-label {
        color: #71717A;
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 6px;
    }

    .info-value {
        color: #18181B;
        font-weight: 600;
    }

    .btn-purple {
        background-color: #7C3AED;
        border: 1px solid #7C3AED;
        color: #FFFFFF;
        border-radius: 10px;
        font-weight: 600;
        padding: 10px 20px;
    }

    .btn-purple:hover {
        background-color: #5B21B6;
        border-color: #5B21B6;
        color: #FFFFFF;
    }
</style>

<div class="result-page py-5">

<div class="container">

    <div class="row justify-content-center">

        <div class="col-12 col-lg-7">

            <div class="result-card shadow-sm">

                <!-- Header -->
                <div class="result-header p-4 p-md-5 text-center">

                    <div class="result-icon">
                        @(passed ? "✓" : "!")
                    </div>

                    <h1 class="result-title fw-bold mb-3">
                        @(passed ? "Quiz Passed!" : "Quiz Failed")
                    </h1>

                    <p class="result-description mb-0">
                        @(passed
                            ? "Congratulations! You passed the quiz successfully."
                            : "You did not reach the required passing score.")
                    </p>

                </div>

                <!-- Result Content -->
                <div class="p-4 p-md-5">

                    <!-- Score -->
                    <div class="score-box mb-4">

                        <div class="score-label">
                            Your Score
                        </div>

                        <div class="score">
                            @score.ToString("0.##")%
                        </div>

                        <div class="mt-3">

                            <span class="status-badge @(passed ? "status-passed" : "status-failed")">
                                @(passed ? "Passed" : "Failed")
                            </span>

                        </div>

                    </div>

                    <!-- Attempt Information -->
                    <div class="row g-3 mb-4">

                        <div class="col-12 col-md-6">

                            <div class="info-box p-4 h-100">

                                <div class="info-label">
                                    Attempt Number
                                </div>

                                <div class="info-value">
                                    @Model.AttemptNumber
                                </div>

                            </div>

                        </div>

                        <div class="col-12 col-md-6">

                            <div class="info-box p-4 h-100">

                                <div class="info-label">
                                    Attempt Date
                                </div>

<div class="info-value">
    @Model.AttemptDate.ToLocalTime().ToString("dd MMMM yyyy")
</div>
                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- Action -->
                    <div class="text-center">

                        <a asp-controller="Quiz"
                           asp-action="Details"
                           asp-route-id="@Model.QuizId"
                           class="btn btn-purple">
                            Back to Quiz
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


</div>
